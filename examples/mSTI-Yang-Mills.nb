Cell["\<\
The field space includes the physical Yang-Mills fields (gluon A, ghosts c \
and cb) plus the BRST source fields (QA, Qcb, Qc).
  - QA is commuting
  - Qcb and Qc are Grassmann\
\>", "Text",
 CellChangeTimes->{{3.981525999053829*^9, 3.981525999705958*^9}, {
  3.9816033841316547`*^9, 3.98160339576766*^9}, {3.9870444307731657`*^9, 
  3.987044431403246*^9}},ExpressionUUID->"a0000001-0001-0001-0001-\
000000000021"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fields", " ", "=", " ", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<Commuting\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"A", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "c"}], "}"}]}], "]"}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<Grassmann\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cb", "[", 
          RowBox[{"p", ",", " ", 
           RowBox[{"{", "c", "}"}]}], "]"}], ",", " ", 
         RowBox[{"c", "[", 
          RowBox[{"p", ",", " ", 
           RowBox[{"{", "c", "}"}]}], "]"}]}], "}"}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<CommutingSource\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Qcb", "[", "p", "]"}], ",", " ", 
        RowBox[{"Qc", "[", "p", "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"\"\<GrassmannSource\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"QA", "[", 
        RowBox[{"p", ",", " ", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "c"}], "}"}]}], "]"}], "}"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9815260391142483`*^9, 3.981526046990234*^9}, 
   3.981526126994158*^9, {3.98154325419699*^9, 3.981543287820754*^9}, {
   3.981543319248837*^9, 3.9815433199325867`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"a0000001-0001-0001-0001-000000000022"],

Cell[BoxData[
 RowBox[{
  RowBox[{"truncation", " ", "=", " ", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GammaN", " ", "->", " ", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"cb", ",", " ", "c"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A", ",", " ", "A", ",", " ", "A"}], "}"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "cb", ",", " ", "c"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "Qcb"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "QA"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "c", ",", " ", "QA"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "c", ",", " ", "Qc"}], "}"}]}], 
       "\[IndentingNewLine]", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Propagator", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"cb", ",", " ", "c"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"R", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"cb", ",", " ", "c"}], "}"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9815296601151752`*^9, 3.981529684963228*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"de4476bf-7acd-4a9c-a810-b0ce948c5875"],

