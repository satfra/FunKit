Notebook[{

Cell[CellGroupData[{
Cell["Modified Slavnov-Taylor Identity: Gluon Two-Point Function", "Title",ExpressionUUID->"a0000001-0001-0001-0001-000000000001"],

Cell[TextData[{
 "This notebook derives the modified Slavnov-Taylor Identity (mSTI) of the \
gluon two-point function in SU(3) Yang-Mills theory.\nThe mSTIs encode BRST \
symmetry in the presence of an infrared momentum cutoff. At scale k, the \
master equation reads:\n                ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"  ", "\[Delta]\[CapitalGamma]"}], 
    RowBox[{
     SuperscriptBox["\[Delta]Q", "a"], " "}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "613c7c77-2244-4987-89e7-bcb330ffaa66"],
 " \[CenterDot] ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Delta]\[CapitalGamma]", 
    SuperscriptBox["\[Delta]\[CapitalPhi]", "a"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a9429b64-dc07-4aed-a2d2-61a54142b643"],
 " =  ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["R", "ab"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc2cfa2f-7972-4514-b3c4-57623814308b"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "bc"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5aeb3aa2-69af-4ce6-a146-ee703f08d02f"],
 " ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[CapitalGamma]", "c"], 
    SuperscriptBox["Q", "a"]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "72e83c2d-c6e7-4226-ac7a-45b3f2462784"],
 "\nFor k \[Rule] 0 the RHS vanishes and the ordinary STIs are recovered."
}], "Text",
 CellChangeTimes->{{3.981525823513937*^9, 3.9815259781139307`*^9}, {
  3.981529542591159*^9, 
  3.981529561026699*^9}},ExpressionUUID->"a0000001-0001-0001-0001-\
000000000002"],

