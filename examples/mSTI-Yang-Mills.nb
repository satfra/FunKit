Cell["Build Setups", "Section",ExpressionUUID->"a0000001-0001-0001-0001-000000000040"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SetupLHS", " ", "=", " ", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<FieldSpace\>\"", " ", "->", " ", "fields"}], ",", 
