Cell[CellGroupData[{

Cell["Field Space", "Section",ExpressionUUID->"a0000001-0001-0001-0001-000000000020"],

Cell["\<\
The field space includes the physical Yang-Mills fields (gluon A, ghosts c \
and cb) plus the BRST source fields (QA, Qcb, Qc).
  - QA is fermionic (paired with a dummy QAbar that never appears in the \
truncation)
  - Qcb and Qc are bosonic (commuting)\
\>", "Text",
 CellChangeTimes->{{3.981525999053829*^9, 
  3.981525999705958*^9}},ExpressionUUID->"a0000001-0001-0001-0001-\
000000000021"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fields", " ", "=", " ", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<Commuting\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"p", ",", " ", 
          RowBox[{"{", 
           RowBox[{"v", ",", " ", "c"}], "}"}]}], "]"}], ",", " ", 
        RowBox[{"Qcb", "[", "p", "]"}], ",", " ", 
        RowBox[{"Qc", "[", "p", "]"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     
     RowBox[{"\"\<Grassmann\>\"", " ", "->", " ", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"cb", "[", 
           RowBox[{"p", ",", " ", 
            RowBox[{"{", "c", "}"}]}], "]"}], ",", " ", 
          RowBox[{"c", "[", 
           RowBox[{"p", ",", " ", 
            RowBox[{"{", "c", "}"}]}], "]"}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"QAbar", "[", 
           RowBox[{"p", ",", " ", 
            RowBox[{"{", 
             RowBox[{"v", ",", " ", "c"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"QA", "[", 
           RowBox[{"p", ",", " ", 
            RowBox[{"{", 
             RowBox[{"v", ",", " ", "c"}], "}"}]}], "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "}"}]}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9815260391142483`*^9, 3.981526046990234*^9}, 
   3.981526126994158*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"a0000001-0001-0001-0001-000000000022"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Truncations", "Section",ExpressionUUID->"a0000001-0001-0001-0001-000000000030"],

Cell["\<\
We use separate truncations for LHS and RHS.
- The LHS truncation includes only the 2-point BRST vertices ({A, Qcb}, {c, \
QA}).
- The RHS truncation includes 3-point BRST vertices ({A, c, QA}, {c, c, Qc}), \
the regulator R, and propagators. It also includes {A, c} in the GammaN \
truncation, which is needed for the ghost triangle diagram.\
\>", "Text",
 CellChangeTimes->{{3.981526051885333*^9, 
  3.981526070217794*^9}},ExpressionUUID->"a0000001-0001-0001-0001-\
000000000031"],

Cell[BoxData[
 RowBox[{
  RowBox[{"truncationLHS", " ", "=", " ", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{"GammaN", " ", "->", " ", 
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"A", ",", " ", "A"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"cb", ",", " ", "c"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"A", ",", " ", "A", ",", " ", "A"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"A", ",", " ", "A", ",", " ", "A", ",", " ", "A"}], "}"}], 
       ",", " ", 
       RowBox[{"{", 
        RowBox[{"A", ",", " ", "cb", ",", " ", "c"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"A", ",", " ", "Qcb"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "QA"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"A", ",", " ", "c", ",", " ", "QA"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"c", ",", " ", "c", ",", " ", "Qc"}], "}"}]}], 
      "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.981526078362299*^9, 3.981526088522129*^9}, {
  3.98152612371493*^9, 3.98152612457001*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"a0000001-0001-0001-0001-000000000032"],

Cell[BoxData[
 RowBox[{
  RowBox[{"truncationRHS", " ", "=", " ", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GammaN", " ", "->", " ", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"cb", ",", " ", "c"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A", ",", " ", "A", ",", " ", "A"}], "}"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "cb", ",", " ", "c"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "c", ",", " ", "QA"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "c", ",", " ", "Qc"}], "}"}]}], 
       "\[IndentingNewLine]", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Propagator", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"cb", ",", " ", "c"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"R", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"cb", ",", " ", "c"}], "}"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9815260915745*^9, 3.981526122490137*^9}, {
  3.981527255990704*^9, 3.981527256394251*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"a0000001-0001-0001-0001-000000000033"],

Cell[BoxData[
 RowBox[{
  RowBox[{"truncation", " ", "=", " ", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GammaN", " ", "->", " ", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"cb", ",", " ", "c"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A", ",", " ", "A", ",", " ", "A"}], "}"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "cb", ",", " ", "c"}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "Qcb"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "QA"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "c", ",", " ", "QA"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "c", ",", " ", "Qc"}], "}"}]}], 
       "\[IndentingNewLine]", "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Propagator", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"cb", ",", " ", "c"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"R", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", " ", "A"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"cb", ",", " ", "c"}], "}"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9815296601151752`*^9, 3.981529684963228*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"de4476bf-7acd-4a9c-a810-b0ce948c5875"]
}, Open  ]],

