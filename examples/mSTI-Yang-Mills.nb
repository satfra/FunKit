Cell["LHS", "Section",
 CellChangeTimes->{{3.981526134729981*^9, 
  3.981526134897059*^9}},ExpressionUUID->"a0000001-0001-0001-0001-\
000000000051"],

Cell["\<\
The LHS of the mSTI is the product of BRST-source derivatives and field-space \
derivatives of the effective action, summed over all BRST source channels:\
\>", "Text",
 CellChangeTimes->{
  3.981526231621849*^9},ExpressionUUID->"a0000001-0001-0001-0001-\
000000000052"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mSTILHS", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "idx", "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"idx", " ", "=", " ", 
       RowBox[{"Symbol", " ", "@", " ", 
        RowBox[{"SymbolName", " ", "@", " ", 
         RowBox[{"Unique", "[", "\"\<a\>\"", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"FEx", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"FTerm", "[", 
         RowBox[{"1", ",", "  ", 
          RowBox[{"GammaN", "[", 
           RowBox[{
            RowBox[{"{", "QA", "}"}], ",", 
            RowBox[{"{", "idx", "}"}]}], "]"}], ",", " ", 
          RowBox[{"GammaN", "[", 
           RowBox[{
            RowBox[{"{", "A", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"-", "idx"}], "}"}]}], "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FTerm", "[", 
         RowBox[{"1", ",", "  ", 
          RowBox[{"GammaN", "[", 
           RowBox[{
            RowBox[{"{", "Qcb", "}"}], ",", 
            RowBox[{"{", "idx", "}"}]}], "]"}], ",", " ", 
          RowBox[{"GammaN", "[", 
           RowBox[{
            RowBox[{"{", "cb", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"-", "idx"}], "}"}]}], "]"}]}], "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"FTerm", "[", 
         RowBox[{"1", ",", " ", 
          RowBox[{"GammaN", "[", 
           RowBox[{
            RowBox[{"{", "Qc", "}"}], ",", 
            RowBox[{"{", "idx", "}"}]}], "]"}], ",", " ", 
          RowBox[{"GammaN", "[", 
           RowBox[{
            RowBox[{"{", "c", "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"-", "idx"}], "}"}]}], "]"}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.981526213534693*^9, 3.981526246682467*^9}, 
   3.9815263185269423`*^9, {3.981526973050407*^9, 3.981526975926263*^9}, {
   3.981528191715025*^9, 3.981528195852539*^9}, {3.9815284515789967`*^9, 
   3.9815284562117777`*^9}, {3.98160345858101*^9, 3.981603465313079*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"a0000001-0001-0001-0001-000000000053"]
}, Open  ]],

Cell[CellGroupData[{

Cell["RHS: One-Loop with Regulator Insertion", "Section",ExpressionUUID->"a0000001-0001-0001-0001-000000000060"],

Cell[TextData[{
 "We pre-expand over the BRST source channels ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SuperscriptBox["Q", "A"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "05fd1f96-f395-4df4-ae82-47456ee16084"],
 " and ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Q", "c"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "06317e77-f55a-417d-895b-276045f6f78c"],
 ") but keep R and Propagator as AnyField. This allows the truncation \
machinery to explore all possible field routes through the loop, which is \
essential for generating the ghost triangle diagram (which requires both ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["G", "AA"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c844a25a-bdb4-49ee-9466-726881073175"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "ccb"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0234fb0e-2b64-445d-bddd-b02d95cf8178"],
 " in the same loop).\n\nThe ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["Q", "cb"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1df98eef-638c-4e35-bb10-b69c1a4e7113"],
 " channel is absent because the BRST transform of cb is proportional to the \
divergence of A (gauge-fixing), and the corresponding one-loop BRST vertex \
does not contribute at this truncation level."
}], "Text",
 CellChangeTimes->{{3.981526251393939*^9, 3.981526251913866*^9}, {
  3.981529572282523*^9, 
  3.9815296212924*^9}},ExpressionUUID->"a0000001-0001-0001-0001-000000000061"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mSTIRHS", " ", "=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b", ",", " ", "c1"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a", "  ", "=", " ", 
       RowBox[{"Symbol", " ", "@", " ", 
        RowBox[{"SymbolName", " ", "@", " ", 
         RowBox[{"Unique", "[", "\"\<a\>\"", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"b", "  ", "=", " ", 
       RowBox[{"Symbol", " ", "@", " ", 
        RowBox[{"SymbolName", " ", "@", " ", 
         RowBox[{"Unique", "[", "\"\<a\>\"", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"c1", " ", "=", " ", 
       RowBox[{"Symbol", " ", "@", " ", 
        RowBox[{"SymbolName", " ", "@", " ", 
         RowBox[{"Unique", "[", "\"\<a\>\"", "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"FEx", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Channel", " ", 
         RowBox[{"Q", "^", "A"}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"FTerm", "[", 
         RowBox[{"1", ",", "\[IndentingNewLine]", 
          RowBox[{"R", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"AnyField", ",", " ", "AnyField"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "a"}], ",", " ", 
              RowBox[{"-", "b"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Propagator", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"AnyField", ",", " ", "AnyField"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"b", ",", " ", "c1"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"GammaN", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"AnyField", ",", " ", "QA"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "c1"}], ",", " ", "a"}], "}"}]}], "]"}]}], 
         "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Channel", " ", 
          RowBox[{"Q", "^", "c"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"FTerm", "[", 
         RowBox[{"1", ",", "\[IndentingNewLine]", 
          RowBox[{"R", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"AnyField", ",", " ", "AnyField"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "a"}], ",", " ", 
              RowBox[{"-", "b"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Propagator", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"AnyField", ",", " ", "AnyField"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"b", ",", " ", "c1"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"GammaN", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"AnyField", ",", " ", "Qc"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "c1"}], ",", " ", "a"}], "}"}]}], "]"}]}], 
         "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{"Channel", " ", 
          RowBox[{"Q", "^", "cb"}]}], " ", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"FTerm", "[", 
         RowBox[{"1", ",", "\[IndentingNewLine]", 
          RowBox[{"R", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"AnyField", ",", " ", "AnyField"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "a"}], ",", " ", 
              RowBox[{"-", "b"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Propagator", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"AnyField", ",", " ", "AnyField"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"b", ",", " ", "c1"}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"GammaN", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"AnyField", ",", " ", "Qcb"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "c1"}], ",", " ", "a"}], "}"}]}], "]"}]}], 
         "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}]}], 
    "\n", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9815262560745983`*^9, 3.9815263228708277`*^9}, {
   3.981527813288129*^9, 3.981527956142496*^9}, 3.981528005099112*^9, {
   3.9815291706270247`*^9, 3.981529182267571*^9}, 3.981603456764583*^9},
 CellLabel->"In[8]:=",ExpressionUUID->"a0000001-0001-0001-0001-000000000062"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Derive the Gluon Two-Point mSTI", "Chapter",ExpressionUUID->"a0000001-0001-0001-0001-000000000070"],

Cell[CellGroupData[{

Cell["LHS Derivation", "Section",ExpressionUUID->"a0000001-0001-0001-0001-000000000071"],

Cell["\<\
We differentiate the LHS with respect to {A, c} and truncate.\
\>", "Text",
 CellChangeTimes->{
  3.981526331085856*^9},ExpressionUUID->"a0000001-0001-0001-0001-\
000000000072"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mSTILHSAc", "=", 
   RowBox[{
    RowBox[{"FTakeDerivatives", "[", 
     RowBox[{"mSTILHS", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", "[", "i1", "]"}], ",", 
        RowBox[{"c", "[", "i2", "]"}]}], "}"}]}], "]"}], "//", 
    "FTruncate"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"mSTILHSAc", "//", "FPlot"}], "//", "FPrint"}], ";"}]}], "Input",
 CellChangeTimes->{{3.981558596214654*^9, 3.9815586337024803`*^9}, {
  3.981603419704262*^9, 3.981603421891857*^9}, {3.9816034846693077`*^9, 
  3.981603484778327*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"b9cd3a7d-1602-42fe-89ed-54bdb86c7e49"],

