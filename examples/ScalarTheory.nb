Cell["\<\
The following defines the scalar field theory and the truncation used. Here, \
the symmetric phase is assumed by setting Field->{} in the truncation. 
Warning: Setting Field->{\[Phi]} will give the results for the broken phase, \
but this will also greatly increase the number of terms in the four- and \
six-point functions, which may take a long time to compute.\
\>", "Text",
 CellChangeTimes->{{3.9745623559444113`*^9, 
  3.974562456126689*^9}},ExpressionUUID->"2d4d1340-d3ce-4311-8576-\
885b55f6be08"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fields", "=", " ", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<Commuting\>\"", "\[Rule]", " ", 
      RowBox[{"{", 
       RowBox[{"\[Phi]", "[", "p", "]"}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"\"\<Grassmann\>\"", "\[Rule]", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"truncation", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GammaN", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "\[Phi]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "\[Phi]", ",", "\[Phi]", ",", "\[Phi]"}], 
         "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Propagator", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", "\[Phi]"}], "}"}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"G", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", "\[Phi]"}], "}"}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Rdot", "->", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{"\[Phi]", ",", "\[Phi]"}], "}"}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"S", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "\[Phi]"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Phi]", ",", "\[Phi]", ",", "\[Phi]", ",", "\[Phi]"}], 
         "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"Field", "->", 
      RowBox[{"{", "}"}]}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"setup", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<FieldSpace\>\"", "->", "fields"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<Truncation\>\"", "->", "truncation"}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FSetGlobalSetup", "[", "setup", "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.97456234769709*^9, 3.974562350143599*^9}, {
  3.978701248805922*^9, 3.9787012515498667`*^9}},
 CellLabel->"In[99]:=",ExpressionUUID->"0546bb23-9f0b-489b-a931-ed21cf968c7a"],

Cell["\<\
If you would like to see what FunKit does underneath, you can set the debug \
level to values greater than 0. The numbers correspond to the following level \
of detail:
0: no info
1: basic information what is happening
2: in-depth what steps are being processed
3: the guts of the program
4: nested guts of the program
5: all details
6: information only needed for debugging\
\>", "Text",
 CellChangeTimes->{{3.974562460778017*^9, 
  3.9745625796267853`*^9}},ExpressionUUID->"a3362598-47d9-4dbc-bbb7-\
e137fcca5f20"],

