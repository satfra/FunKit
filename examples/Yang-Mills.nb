         SuperscriptBox["\[Xi]", 
          RowBox[{"-", "1"}]]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"InverseProp", ",", 
           RowBox[{"{", 
            RowBox[{"cb", ",", "c"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], ":>", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Zc", "[", 
            SqrtBox[
             RowBox[{"sp", "[", 
              RowBox[{"p2", ",", "p2"}], "]"}]], "]"}]}], 
          RowBox[{"sp", "[", 
           RowBox[{"p2", ",", "p2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"GammaN", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
         RowBox[{"ZAcbc", "[", 
          RowBox[{"p1", ",", "p2"}], "]"}]}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"GammaN", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "A", ",", "A"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
         RowBox[{"ZA3", "[", 
          RowBox[{"p1", ",", "p2"}], "]"}]}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"GammaN", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "A", ",", "A", ",", "A"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_", ",", "p3_", ",", "p4_"}], "}"}]}], 
          "]"}], ":>", 
         RowBox[{"ZA4", "[", 
          RowBox[{"p1", ",", "p2", ",", "p3"}], "]"}]}], " ", ",", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"S", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
         "gS"}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"S", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "A", ",", "A"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
         "gS"}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"S", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "A", ",", "A", ",", "A"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_", ",", "p3_", ",", "p4_"}], "}"}]}], 
          "]"}], ":>", 
         SuperscriptBox["gS", "2"]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"S", ",", 
           RowBox[{"{", 
            RowBox[{"cb", ",", "c"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], "->", 
         RowBox[{"sp", "[", 
          RowBox[{"p2", ",", "p2"}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"S", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "A"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], "->", 
         RowBox[{"sp", "[", 
          RowBox[{"p2", ",", "p2"}], "]"}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ZAcbc", "[", 
          RowBox[{"p1_", ",", "p2_"}], "]"}], ":>", 
         RowBox[{"ZAcbc", "[", 
          RowBox[{"\[Sqrt]", 
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "3"], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"sp", "[", 
                RowBox[{"p1", ",", "p1"}], "]"}], "+", 
               RowBox[{"sp", "[", 
                RowBox[{"p2", ",", "p2"}], "]"}], "+", 
               RowBox[{"sp", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "p1"}], "-", "p2"}], ",", 
                 RowBox[{
                  RowBox[{"-", "p1"}], "-", "p2"}]}], "]"}]}], ")"}]}], 
            ")"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ZA3", "[", 
          RowBox[{"p1_", ",", "p2_"}], "]"}], ":>", 
         RowBox[{"ZA3", "[", 
          RowBox[{"\[Sqrt]", 
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "3"], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"sp", "[", 
                RowBox[{"p1", ",", "p1"}], "]"}], "+", 
               RowBox[{"sp", "[", 
                RowBox[{"p2", ",", "p2"}], "]"}], "+", 
               RowBox[{"sp", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "p1"}], "-", "p2"}], ",", 
                 RowBox[{
                  RowBox[{"-", "p1"}], "-", "p2"}]}], "]"}]}], ")"}]}], 
            ")"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"ZA4", "[", 
          RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "]"}], ":>", 
         RowBox[{"ZA4", "[", 
          RowBox[{"\[Sqrt]", 
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", "4"], 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"sp", "[", 
                RowBox[{"p1", ",", "p1"}], "]"}], "+", 
               RowBox[{"sp", "[", 
                RowBox[{"p2", ",", "p2"}], "]"}], "+", 
               RowBox[{"sp", "[", 
                RowBox[{"p3", ",", "p3"}], "]"}], "+", 
               RowBox[{"sp", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "p1"}], "-", "p2", "-", "p3"}], ",", 
                 RowBox[{
                  RowBox[{"-", "p1"}], "-", "p2", "-", "p3"}]}], "]"}]}], 
              ")"}]}], ")"}]}], "]"}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"nZA", "->", "6"}], ",", "\[IndentingNewLine]", 
        RowBox[{"evP", ":>", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["k", "nZA"], "+", "1"}], ")"}], 
          RowBox[{"1", "/", "nZA"}]]}], ",", "\[IndentingNewLine]", 
        RowBox[{"devP", ":>", 
         RowBox[{
          SuperscriptBox["k", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "nZA"}]], " ", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SuperscriptBox["k", "nZA"]}], ")"}], 
           RowBox[{
            RowBox[{"-", "1"}], "+", 
            RowBox[{"1", "/", "nZA"}]}]]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"Rdot", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "A"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], ":>", 
         RowBox[{
          RowBox[{
           RowBox[{"ZA", "[", "evP", "]"}], 
           RowBox[{"RBdot", "[", 
            RowBox[{
             SuperscriptBox["k", "2"], ",", 
             RowBox[{"sp", "[", 
              RowBox[{"p2", ",", "p2"}], "]"}]}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"RB", "[", 
            RowBox[{
             SuperscriptBox["k", "2"], ",", 
             RowBox[{"sp", "[", 
              RowBox[{"p2", ",", "p2"}], "]"}]}], "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"dtZA", "[", "evP", "]"}], "+", 
             RowBox[{"k", "*", "devP", "*", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"ZA", "[", 
                   RowBox[{"1.02", "evP"}], "]"}], "-", 
                  RowBox[{"ZA", "[", "evP", "]"}]}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"0.02", "*", "evP"}], ")"}]}], ")"}]}]}], 
            ")"}]}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"Rdot", ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", "cb"}], "}"}], ",", "1", ",", 
