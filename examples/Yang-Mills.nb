Cell[BoxData[
 RowBox[{"FTakeDerivatives", "::", "usage"}]], "Input",
 CellChangeTimes->{{3.978680258695291*^9, 3.978680261002531*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"ff937592-6161-4f30-998a-b80cd4206d98"],

Cell[BoxData["\<\"FTakeDerivatives[setup, expr, derivativeList]\\nTakes \
multiple functional derivatives of expr with respect to the fields specified \
in derivativeList.\\nReturns the result with all derivative operators \
resolved.\\nFTakeDerivatives[setup, expr, derivativeList, \\\"Symmetries\\\" \
-> symmetries] allows specifying symmetries for simplification.\\nThe \
derivativeList should be a list of field expressions like {A[i1], \
A[i2]}.\"\>"], "Output",
 CellChangeTimes->{
  3.978680261379862*^9, 3.978693103710397*^9, 3.978693156180573*^9, 
   3.97869326507093*^9, 3.9786933160607977`*^9, {3.983845194479374*^9, 
   3.983845200486236*^9}, 3.983845245250288*^9, 3.9839688691793747`*^9, 
