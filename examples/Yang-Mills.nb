Cell[BoxData[
 RowBox[{
  RowBox[{"dressingRules", "=", 
   RowBox[{
    RowBox[{"ReplaceRepeated", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"GammaN", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "A"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], ":>", 
         RowBox[{
          RowBox[{"ZA", "[", 
           SqrtBox[
            RowBox[{"sp", "[", 
             RowBox[{"p2", ",", "p2"}], "]"}]], "]"}], 
          RowBox[{"sp", "[", 
           RowBox[{"p2", ",", "p2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"GammaN", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "A"}], "}"}], ",", "2", ",", 
           RowBox[{"{", 
            RowBox[{"a_", ",", "b_"}], "}"}]}], "]"}], ":>", 
         SuperscriptBox["\[Xi]", 
          RowBox[{"-", "1"}]]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"GammaN", ",", 
           RowBox[{"{", 
            RowBox[{"cb", ",", "c"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], ":>", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Zc", "[", 
            SqrtBox[
             RowBox[{"sp", "[", 
              RowBox[{"p2", ",", "p2"}], "]"}]], "]"}]}], 
          RowBox[{"sp", "[", 
           RowBox[{"p2", ",", "p2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"InverseProp", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "A"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], ":>", 
         RowBox[{
          RowBox[{"ZA", "[", 
           SqrtBox[
            RowBox[{"sp", "[", 
             RowBox[{"p2", ",", "p2"}], "]"}]], "]"}], 
          RowBox[{"sp", "[", 
           RowBox[{"p2", ",", "p2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"InverseProp", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "A"}], "}"}], ",", "2", ",", 
           RowBox[{"{", 
