Cell[TextData[{
 "To obtain the gap equation, we now take another functional derivative of \
dseA by using the FTakeDerivatives function . We immediately truncate the \
result, i . e . insert explicit fields and remove all vertices not specified \
in the truncation list . The result is plotted, the momentum - routed and \
printed as ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"L", 
     StyleBox[
      AdjustmentBox["A",
       BoxBaselineShift->-0.4,
       BoxMargins->{{-0.5, -0.3}, {0, 0}}],
      FontSize->Smaller], "T", 
     AdjustmentBox["E",
      BoxBaselineShift->0.5,
      BoxMargins->{{-0.3, 0}, {0, 0}}], "X"}],
    SingleLetterItalics->False], TraditionalForm]],ExpressionUUID->
  "5970c90c-bc3c-46f4-9708-2c5acdbc6e89"],
 "."
}], "Text",
 CellChangeTimes->{{3.978680129503028*^9, 3.978680225488174*^9}, 
   3.978681121100779*^9},ExpressionUUID->"de536e35-b283-42f3-ab7c-\
37b7fa52f8e0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DSEAA", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FTakeDerivatives", "[", 
        RowBox[{"dseA", ",", 
         RowBox[{"{", 
          RowBox[{"A", "[", "i2", "]"}], "}"}]}], "]"}], "//", "FTruncate"}], 
      "//", "FPlot"}], "//", "FRoute"}], "//", "FPrint"}]}], ";"}]], "Input",
