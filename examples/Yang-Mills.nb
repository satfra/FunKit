Cell[BoxData[
 RowBox[{"FTakeDerivatives", "::", "usage"}]], "Input",
 CellChangeTimes->{{3.978680258695291*^9, 3.978680261002531*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"ff937592-6161-4f30-998a-b80cd4206d98"],

Cell[BoxData["\<\"FTakeDerivatives[setup, expr, derivativeList]\\nTakes \
multiple functional derivatives of expr with respect to the fields specified \
in derivativeList.\\nReturns the result with all derivative operators \
resolved.\\nFTakeDerivatives[setup, expr, derivativeList, \\\"Symmetries\\\" \
-> symmetries] allows specifying symmetries for simplification.\\nThe \
derivativeList should be a list of field expressions like {A[i1], \
A[i2]}.\"\>"], "Output",
 CellChangeTimes->{
  3.978680261379862*^9, 3.978693103710397*^9, 3.978693156180573*^9, 
   3.97869326507093*^9, 3.9786933160607977`*^9, {3.983845194479374*^9, 
   3.983845200486236*^9}, 3.983845245250288*^9, 3.9839688691793747`*^9, 
   3.9839691825035257`*^9, 3.983969248581135*^9, 3.9839693617922153`*^9, 
   3.983969467462529*^9, 3.9839695557346277`*^9, 3.983969607818059*^9, 
   3.9839696848234463`*^9, 3.983969793563738*^9, 3.983969836818819*^9, 
   3.9839699022377768`*^9, 3.9839699988688087`*^9, 3.9839701004310083`*^9, 
   3.9842997882229843`*^9, 3.994751098256805*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"bec1edd3-2532-431d-a991-43da35255442"]
}, Open  ]],

Cell["\<\
Also, you can use FInfo[] in any Notebook to get an explanation of some \
general concepts of FunKit\
\>", "Text",
 InitializationCell->True,
 CellChangeTimes->{{3.978690233471107*^9, 
  3.978690282230137*^9}},ExpressionUUID->"66c61c1b-f8ea-41f1-800a-\
fd34911855aa"],

Cell["\<\
In the following, we define the gauge-fixed Yang-Mills theory and the \
truncation used.
First, we define our field space that includes bosonic and fermionic fields A \
(gluons) and cb,c (ghosts)\
\>", "Text",
 CellChangeTimes->{{3.9745623559444113`*^9, 3.974562456126689*^9}, {
  3.974954975059205*^9, 3.974955020617908*^9}, {3.978678360601655*^9, 
  3.97867842277036*^9}, {3.9786800455665894`*^9, 
  3.97868004577847*^9}},ExpressionUUID->"23a7f0c1-84e0-430d-b51c-\
fd52a5ea6bbc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fields", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<Commuting\>\"", "\[Rule]", " ", 
      RowBox[{"{", 
       RowBox[{"A", "[", 
        RowBox[{"p", ",", 
         RowBox[{"{", 
          RowBox[{"v", ",", " ", "c"}], "}"}]}], "]"}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<Grassmann\>\"", "\[Rule]", 
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"cb", "[", 
          RowBox[{"p", ",", 
           RowBox[{"{", "c", "}"}]}], "]"}], ",", 
         RowBox[{"c", "[", 
          RowBox[{"p", ",", 
           RowBox[{"{", "c", "}"}]}], "]"}]}], "}"}], "}"}]}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.978681475423225*^9, 3.9786814760994053`*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"23cd82e3-0262-4431-84e5-0588cb9046a5"],

Cell["\<\
Next, the truncation specifies which interactions are taken into account, for \
each kind of object that can appear in an equation. To see all objects, call \
ShowIndexedObjects[]. In the following, we set the truncation for fields \
explicitly to nothing, as we wish to look at the symmetric (vacuum) phase of \
Yang-Mills theory.\
\>", "Text",
 CellChangeTimes->{{3.978678428383665*^9, 3.9786784703508577`*^9}, {
  3.9786785043626137`*^9, 
  3.9786785459422703`*^9}},ExpressionUUID->"5f91bc27-97cb-46e1-8db0-\
24c58f907a88"],

Cell[BoxData[
 RowBox[{
  RowBox[{"truncation", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GammaN", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", "A"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A", ",", "A"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A", ",", "A", ",", "A"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"cb", ",", "c"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Propagator", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", "A"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"cb", ",", "c"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"Rdot", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", "A"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"cb", ",", "c"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"S", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", "A"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A", ",", "A"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A", ",", "A", ",", "A"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"cb", ",", "c"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"cb", ",", "c", ",", "A"}], "}"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"Field", "->", 
      RowBox[{"{", 
       RowBox[{"{", "}"}], "}"}]}]}], "\[IndentingNewLine]", "|>"}]}], 
  ";"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[3]:=",ExpressionUUID->"b2207f16-96a3-4aca-9f2f-804afa7a3158"],

Cell["\<\
The bases used for explicit tracing of the expressions are specified next. \
This is used by FunKit to create diagrammatic rules with \
FMakeDiagrammaticRules[Setup] later on; of course, you can also specify the \
diagrammatic rules by hand.
If you want to use FMakeDiagrammaticRules, any basis must be known to \
TensorBases, the framework used by FunKit to manage vertex bases. To see how \
to define new bases, see both the corresponding publication \
https://arxiv.org/abs/2503.05580 and the TensorBases showcase notebook at \
https://github.com/satfra/TensorBases/blob/main/examples/Showcase.nb
To see a list of all available bases, call TBInfo[] and for information on a \
specific basis TBInfo[\[OpenCurlyDoubleQuote]AA\[CloseCurlyDoubleQuote]], \
here at the example of the two-gluon basis.

In the bases Association, we now attach a list of vertex rules to each object \
that should be written out using TensorBases. There are several ways to \
specify a basis:
  1. GammaN->{{A, A, A} -> \[OpenCurlyDoubleQuote]AAAClass\
\[CloseCurlyDoubleQuote], ...} simply leads to FunKit using the full basis \
\[OpenCurlyDoubleQuote]AAAClass\[CloseCurlyDoubleQuote] for any object \
GammaN[{A,A,A},{....}]
  2. GammaN->{{A, qb, q} -> {\[OpenCurlyDoubleQuote]AqbqDirect\
\[CloseCurlyDoubleQuote], 1,4,7}, ...} leads to FunKit using the elements 1, \
4 and 7 from the basis \[OpenCurlyDoubleQuote]AqbqDirect\
\[CloseCurlyDoubleQuote] for any object GammaN[{A,qb,q},{....}]
  3. GammaN->{{A, sb,s} -> {\[OpenCurlyDoubleQuote]AqbqDirectSF\
\[CloseCurlyDoubleQuote], 1,4,7,s->q,sb->qb}, ...} leads to FunKit using the \
elements 1, 4 and 7 from the basis \[OpenCurlyDoubleQuote]AqbqDirectSF\
\[CloseCurlyDoubleQuote] for any object GammaN[{A,sb,s},{....}]
For the third example, the  additional rules are needed to translate the \
names of fields as used in the basis to the one used in your code.\
\>", "Text",
 CellChangeTimes->{{3.978678552099695*^9, 3.9786786243784*^9}, {
  3.9786786571538143`*^9, 3.9786787477149897`*^9}, {3.978678799086419*^9, 
  3.9786791808306932`*^9}, {3.978679215707508*^9, 
  3.978679288810836*^9}},ExpressionUUID->"ea5be9f3-7d4a-4447-a32c-\
85ce4df732a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"bases", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"GammaN", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"A", ",", "A"}], "}"}], "->", 
         RowBox[{"{", 
          RowBox[{"\"\<AA\>\"", ",", "1"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"A", ",", "A", ",", "A"}], "}"}], 
         "->", "\"\<AAAClass\>\""}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"A", ",", "A", ",", "A", ",", "A"}], "}"}], 
         "->", "\"\<AAAAClass\>\""}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"A", ",", "cb", ",", "c"}], "}"}], "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Acbc\>\"", ",", "1"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cb", ",", "c"}], "}"}], "->", "\"\<cbc\>\""}]}], "}"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"S", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"A", ",", "A"}], "}"}], "->", 
         RowBox[{"{", 
          RowBox[{"\"\<AA\>\"", ",", "1"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"A", ",", "A", ",", "A"}], "}"}], 
         "->", "\"\<AAAClass\>\""}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"A", ",", "A", ",", "A", ",", "A"}], "}"}], 
         "->", "\"\<AAAAClass\>\""}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"A", ",", "cb", ",", "c"}], "}"}], "->", 
         RowBox[{"{", 
          RowBox[{"\"\<Acbc\>\"", ",", "1"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cb", ",", "c"}], "}"}], "->", "\"\<cbc\>\""}]}], "}"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"Propagator", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"A", ",", "A"}], "}"}], "->", "\"\<AA\>\""}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cb", ",", "c"}], "}"}], "->", "\"\<cbc\>\""}]}], "}"}]}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"Rdot", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"A", ",", "A"}], "}"}], "->", 
         RowBox[{"{", 
          RowBox[{"\"\<AA\>\"", ",", "1"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"cb", ",", "c"}], "}"}], "->", "\"\<cbc\>\""}]}], "}"}]}]}],
     "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[4]:=",ExpressionUUID->"e28c27da-c44b-4bc9-849d-88286e6dc88e"],

Cell["\<\
DiagramStyling does exactly what it sounds like: You can give line-styles for \
propagators with the associated fields in Feynman diagrams. Note that for \
paired fields (fermion/antifermion, or complex scalars) you only need to \
specify one of both.\
\>", "Text",
 CellChangeTimes->{{3.978679323351844*^9, 
  3.9786793873065033`*^9}},ExpressionUUID->"650bcadc-982b-45b6-aae3-\
15a6c3c7139d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"diagramStyling", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{"\"\<EdgeStyles\>\"", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A", "->", 
        RowBox[{"{", "Orange", "}"}]}], ",", 
       RowBox[{"c", "->", 
        RowBox[{"{", 
         RowBox[{"Black", ",", "Dashed"}], "}"}]}]}], "}"}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[5]:=",ExpressionUUID->"6338faa3-4ee5-4fcb-9934-c49d40e3a267"],

Cell["\<\
Finally, the setup Association puts the specifics of the theory defined above \
together and is passed to FunKit as the Global Setup to be used in all calls \
to FunKit\[CloseCurlyQuote]s functions.
Note that it is not necessary to set a global setup, instead one could also \
pass Setup as the first parameter to all functions - as this is usually more \
cumbersome, however, we opt for setting the setup globally.\
\>", "Text",
 CellChangeTimes->{{3.978679389515477*^9, 
  3.978679492858526*^9}},ExpressionUUID->"867a5a00-b242-46a2-accc-\
86a8250984df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Setup", "=", 
   RowBox[{"<|", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\"\<FieldSpace\>\"", "->", "fields"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<Truncation\>\"", "->", "truncation"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<FeynmanRules\>\"", "->", "bases"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"\"\<DiagramStyling\>\"", "->", "diagramStyling"}]}], 
    "\[IndentingNewLine]", "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FSetGlobalSetup", "[", "Setup", "]"}], ";"}]}], "Input",
 InitializationCell->True,
 CellLabel->"In[6]:=",ExpressionUUID->"35f56496-f0d8-40a4-8f64-e662cb2a69b0"],

Cell["\<\
Finally, to get correctly formatted LaTeX output, we can add some custom \
replacements for the FTex and FPrint commands, which we use to actually put a \
bar above the anti - ghost field instead of printing out cb.\
\>", "Text",
 CellChangeTimes->{{3.978679505640008*^9, 
  3.9786795734465837`*^9}},ExpressionUUID->"9be787e8-9120-4665-9e1e-\
b780cffb61f4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FSetTexStyles", "[", 
   RowBox[{"cb", "->", "\"\<\\\\bar{c}\>\""}], "]"}], ";"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[8]:=",ExpressionUUID->"e8306d11-3a02-47fd-9690-25834dbacb13"],

Cell["\<\
Using the MakeDiagrammaticRules command, FunKit will produce output where \
every vertex is dressed with a dressing[Object, {fields, ...}, basisIndex, \
{momenta, ...}]. We want to explicitly parameterise these dressings with \
wavefunctions, so we define the function dressingRules in the following:\
\>", "Text",
 CellChangeTimes->{{3.953390064624902*^9, 3.9533900705042467`*^9}, 
   3.9533912867122517`*^9, 3.953391470013318*^9, {3.9533954751532803`*^9, 
   3.953395475634337*^9}, {3.953435713474752*^9, 3.953435718216131*^9}, {
