Cell["\<\
The FormTracer output contains certain functions for expressing scalar \
products, which we also convert to explicit variables.\
\>", "Text",
 CellChangeTimes->{{3.978679709275914*^9, 
  3.978679774682839*^9}},ExpressionUUID->"b71e2594-3194-4653-9855-\
780bae78fcd0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PropParam", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{"UseLorentzLinearity", "[", "expr", "]"}], "//.", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lf1", "->", "l1"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "FunKit", " ", "marks", " ", "purely", " ", "fermionic", " ", "loop", 
         " ", "momenta", " ", "with", " ", "an", " ", 
         RowBox[{"f", ".", " ", "This"}], " ", "is", " ", "useful", " ", 
         "for", " ", "finite", " ", "T", " ", "calculations"}], ",", " ", 
        RowBox[{
        "where", " ", "Matsubara", " ", "frequencies", " ", "are", " ", 
         "shifted", " ", "by", " ", 
         RowBox[{"\[Pi]T", "!"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"p1", ",", "p1"}], "]"}], "->", 
       SuperscriptBox["p", "2"]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l2", ",", "l2"}], "]"}], "->", 
       SuperscriptBox["l2", "2"]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l1", ",", "l1"}], "]"}], "->", 
       SuperscriptBox["l1", "2"]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l1", ",", "p1"}], "]"}], "->", 
       RowBox[{"l1", " ", "p", " ", 
        RowBox[{"cos", "[", 
         RowBox[{"p", ",", "l1"}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l2", ",", "p1"}], "]"}], "->", 
       RowBox[{"l2", " ", "p", " ", 
        RowBox[{"cos", "[", 
         RowBox[{"p", ",", "l2"}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l1", ",", "l2"}], "]"}], "->", 
       RowBox[{"l1", " ", "l2", " ", 
        RowBox[{"cos", "[", 
         RowBox[{"l1", ",", "l2"}], "]"}]}]}], ",", 
      RowBox[{
       SqrtBox[
        SuperscriptBox["a_", "2"]], ":>", "a"}], ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["a_", "2"], ")"}], 
        FractionBox["n_", "2"]], ":>", 
       SuperscriptBox["a", "n"]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p", ",", "l1"}], "]"}], ":>", "cospl1"}], ",", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p", ",", "l1"}], "]"}], ":>", "cospl2"}]}], 
     "\[IndentingNewLine]", "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SPParam", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{"UseLorentzLinearity", "[", "expr", "]"}], "//.", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lf1", "->", "l1"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "FunKit", " ", "marks", " ", "purely", " ", "fermionic", " ", "loop", 
         " ", "momenta", " ", "with", " ", "an", " ", 
         RowBox[{"f", ".", " ", "This"}], " ", "is", " ", "useful", " ", 
         "for", " ", "finite", " ", "T", " ", "calculations"}], ",", " ", 
        RowBox[{
        "where", " ", "Matsubara", " ", "frequencies", " ", "are", " ", 
         "shifted", " ", "by", " ", 
         RowBox[{"\[Pi]T", "!"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"p", ",", "p"}], "]"}], "->", 
       SuperscriptBox["p", "2"]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l1", ",", "l1"}], "]"}], "->", 
       SuperscriptBox["l1", "2"]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l1", ",", "l2"}], "]"}], "->", 
       RowBox[{"l1", " ", "l2", " ", 
        RowBox[{"cos", "[", 
         RowBox[{"l1", ",", "l2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"p", ",", "l1"}], "]"}], "->", 
       RowBox[{"l1", " ", "p", " ", 
        RowBox[{"cos", "[", 
         RowBox[{"p", ",", "l2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       SqrtBox[
        SuperscriptBox["a_", "2"]], ":>", "a"}], ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["a_", "2"], ")"}], 
        FractionBox["n_", "2"]], ":>", 
       SuperscriptBox["a", "n"]}], ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["a_", "2"], ")"}], 
        RowBox[{"n_", "/", "2"}]], ":>", 
       SuperscriptBox["a", "n"]}], ",", 
      RowBox[{
       RowBox[{"Power", "[", 
        RowBox[{
         RowBox[{"Power", "[", 
          RowBox[{"l1_", ",", "2"}], "]"}], ",", 
         RowBox[{"Rational", "[", 
          RowBox[{"n_", ",", "2"}], "]"}]}], "]"}], ":>", 
       SuperscriptBox["l1", "n"]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p1", ",", "l1"}], "]"}], ":>", "cosl1p1"}], ",", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p2", ",", "l1"}], "]"}], ":>", "cosl1p2"}], ",", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p3", ",", "l1"}], "]"}], ":>", "cosl1p3"}], ",", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p4", ",", "l1"}], "]"}], ":>", "cosl1p4"}]}], 
     "\[IndentingNewLine]", "}"}]}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{
  3.97867970541567*^9, {3.9786797859278917`*^9, 3.978679861788776*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"f43460c3-c485-462c-9409-533d01c074c6"],

Cell["\<\
Finally, we just define a few projectors onto symmetric points and set the \
number of colours to 3.\
\>", "Text",
 CellChangeTimes->{{3.978679862876096*^9, 
  3.978679893750785*^9}},ExpressionUUID->"3065cf40-b65b-4bce-9bf7-\
af765e8e8f8c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SP3Project", "=", 
   RowBox[{
    RowBox[{"TBProjectToSymmetricPoint", "[", 
     RowBox[{"#", ",", "l1", ",", "p", ",", "p1", ",", "p2", ",", "p3"}], 
     "]"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SP4Project", "=", 
   RowBox[{
    RowBox[{"TBProjectToSymmetricPoint", "[", 
     RowBox[{
     "#", ",", "l1", ",", "p", ",", "p1", ",", "p2", ",", "p3", ",", "p4"}], 
     "]"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SetNc", "[", "3", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"k", ">", "0"}], "&&", 
    RowBox[{"p", ">", "0"}], "&&", 
    RowBox[{"l1", ">", "0"}], "&&", 
    RowBox[{
     RowBox[{"-", "1"}], "<", "cos1", "<", 
     RowBox[{"1", "-", "1"}], "<", "cos2", "<", "1"}], "&&", 
    RowBox[{
     RowBox[{"-", "1"}], "<", "cos3", "<", "1"}]}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{3.978679872066907*^9},
 CellLabel->"In[12]:=",ExpressionUUID->"8735de70-7646-46b5-bf4e-58cbea4460bc"]
}, Closed]],

