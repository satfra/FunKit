   RowBox[{"\"\<Name\>\"", "->", "\"\<DSEAA1Loop\>\""}], ",", 
   RowBox[{"\"\<Parameters\>\"", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<l1\>\"", ",", "\"\<p\>\"", ",", "\"\<cospl1\>\"", 
