         SuperscriptBox["\[Xi]", 
          RowBox[{"-", "1"}]]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"InverseProp", ",", 
           RowBox[{"{", 
            RowBox[{"cb", ",", "c"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], ":>", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"Zc", "[", 
            SqrtBox[
             RowBox[{"sp", "[", 
              RowBox[{"p2", ",", "p2"}], "]"}]], "]"}]}], 
          RowBox[{"sp", "[", 
           RowBox[{"p2", ",", "p2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"GammaN", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
         RowBox[{"ZAcbc", "[", 
          RowBox[{"p1", ",", "p2"}], "]"}]}], ",", " ", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"dressing", "[", 
          RowBox[{"GammaN", ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "A", ",", "A"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
         RowBox[{"ZA3", "[", 
          RowBox[{"p1", ",", "p2"}], "]"}]}], ",", " ", "\[IndentingNewLine]", 
