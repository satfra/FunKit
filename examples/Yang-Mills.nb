Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"MakeCppFunction", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "@", "DSEAAResult"}], "/.", 
    RowBox[{"\[Xi]", "->", "0"}]}], ",", 
   RowBox[{"\"\<Name\>\"", "->", "\"\<DSEAA1Loop\>\""}], ",", 
   RowBox[{"\"\<Parameters\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<l1\>\"", ",", "\"\<p\>\"", ",", "\"\<cospl1\>\"", ",", "\"\<gS\>\"",
       ",", "\"\<ZA\>\"", ",", "\"\<Zc\>\"", ",", "\"\<ZA3\>\"", ",", 
      "\"\<ZAcbc\>\""}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"MakeJuliaFunction", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "@", "DSEAAResult"}], "/.", 
    RowBox[{"\[Xi]", "->", "0"}]}], ",", 
   RowBox[{"\"\<Name\>\"", "->", "\"\<DSEAA1Loop\>\""}], ",", 
   RowBox[{"\"\<Parameters\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<l1\>\"", ",", "\"\<p\>\"", ",", "\"\<cospl1\>\"", ",", "\"\<gS\>\"",
       ",", "\"\<ZA\>\"", ",", "\"\<Zc\>\"", ",", "\"\<ZA3\>\"", ",", 
      "\"\<ZAcbc\>\""}], "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.974955091194139*^9, 3.974955110742147*^9}, {
   3.9749551863902683`*^9, 3.974955207390588*^9}, 3.974955421266271*^9, {
   3.975062117688541*^9, 3.9750621394746943`*^9}, {3.9750623210821247`*^9, 
   3.975062339466655*^9}, {3.9750627755951*^9, 3.975062776350016*^9}, {
   3.978680725043457*^9, 3.978680741727203*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"fe57f41a-7330-4ba3-88c4-9f8b1d80e482"],

Cell[BoxData["\<\"auto DSEAA1Loop(const auto &l1, const auto &p, const auto \
&cospl1, const auto &gS, const auto &ZA, const auto &Zc,\\n                \
const auto &ZA3, const auto &ZAcbc)\\n{\\n  const auto _repl1 = ZA(l1);\\n  \
const auto _repl2 = powr<2>(l1);\\n  const auto _repl3 = powr<2>(p);\\n  \
const auto _repl4 = powr<2>(cospl1);\\n  const auto _repl5 = powr<3>(p);\\n  \
const auto _repl6 = powr<4>(p);\\n  const auto _repl7 = powr<-2>(p);\\n  \
const auto _repl8 = powr<-4>(l1);\\n  return (powr<-1>(_repl1)) * ((7.) * \
((_repl2) * (_repl3)) + (-1.) * ((_repl2) * ((_repl3) * (_repl4)))) *\\n      \
       ((_repl7) * ((_repl8) * (powr<2>(gS)))) +\\n         (-0.5) *\\n       \
      ((12.) * ((_repl3) * (powr<6>(l1))) +\\n              (_repl2) *\\n     \
             ((-4.) * ((_repl2) * ((_repl3) * (_repl4))) + (-12.) * (_repl6) \
+\\n                   (-24.) * ((_repl5) * ((cospl1) * (l1)))) *\\n          \
        ((_repl3) * (_repl4)) +\\n              ((-12.) * ((_repl2) * \
((_repl3) * (_repl4))) + (32.) * (_repl6) +\\n               (24.) * \
((_repl5) * ((cospl1) * (l1)))) *\\n                  (powr<4>(l1)) +\\n      \
        ((-28.) * ((_repl2) * ((_repl4) * (_repl6))) + (-24.) * ((_repl5) * \
((powr<3>(cospl1)) * (powr<3>(l1)))) +\\n               (24.) * ((cospl1) * \
((l1) * (powr<5>(p)))) + (12.) * (powr<6>(p))) *\\n                  \
(_repl2)) *\\n             ((powr<-1>(_repl1)) *\\n              ((_repl7) \
*\\n               ((_repl8) * ((gS) * ((powr<-2>(_repl2 + _repl3 + (2.) * \
((cospl1) * ((l1) * (p))))) *\\n                                    \
((powr<-1>(ZA(sqrt(_repl2 + _repl3 + (2.) * ((cospl1) * ((l1) * (p))))))) \
*\\n                                     (ZA3((0.5773502691896258) * \
(sqrt((2.) * (_repl2) + (2.) * (_repl3) +\\n                                  \
                                     (2.) * ((cospl1) * ((l1) * \
(p))))))))))))) +\\n         (gS) * ((-1.) * (_repl2) + (_repl2) * (_repl4)) \
*\\n             ((powr<-2>(l1)) *\\n              ((powr<-1>(_repl2 + _repl3 \
+ (2.) * ((cospl1) * ((l1) * (p))))) *\\n               \
((ZAcbc((0.5773502691896258) *\\n                       (sqrt((2.) * (_repl2) \
+ (2.) * (_repl3) + (2.) * ((cospl1) * ((l1) * (p))))))) *\\n                \
((powr<-1>(Zc(l1))) * (powr<-1>(Zc(sqrt(_repl2 + _repl3 + (2.) * ((cospl1) * \
((l1) * (p)))))))))));\\n}\"\>"], "Output",
 CellChangeTimes->{
  3.974955424068762*^9, {3.9750621216605597`*^9, 3.975062140645183*^9}, {
   3.97506232652857*^9, 3.97506234098042*^9}, 3.975062848524881*^9, 
   3.978680749072611*^9},
 CellLabel->"Out[53]=",ExpressionUUID->"48172f9a-71df-492d-8795-ad6d35c3dc0c"],

Cell[BoxData["\<\"function DSEAA1Loop(l1, p, cospl1, gS, ZA, Zc, ZA3, \
ZAcbc)\\n  _repl1 = ZA(l1)\\n  _repl2 = l1^(-4)\\n  _repl3 = p^(-2)\\n  \
_repl4 = l1^2\\n  _repl5 = p^2\\n  _repl6 = cospl1^2\\n  _repl7 = p^3\\n  \
_repl8 = p^4\\n  return (_repl2*_repl3*(7*_repl4*_repl5 - \
_repl4*_repl5*_repl6)*gS^2)/_repl1 - (_repl2*_repl3*gS*(12*_repl5*l1^6 + \
_repl4*_repl5*_repl6*(-4*_repl4*_repl5*_repl6 - 12*_repl8 - \
24*_repl7*cospl1*l1) + l1^4*(-12*_repl4*_repl5*_repl6 + 32*_repl8 + \
24*_repl7*cospl1*l1) + _repl4*(-28*_repl4*_repl6*_repl8 - \
24*_repl7*cospl1^3*l1^3 + 24*cospl1*l1*p^5 + 12*p^6))*ZA3(sqrt(2*_repl4 + \
2*_repl5 + 2*cospl1*l1*p)/sqrt(3)))/(2*_repl1*(_repl4 + _repl5 + \
2*cospl1*l1*p)^2*ZA(sqrt(_repl4 + _repl5 + 2*cospl1*l1*p))) + ((-_repl4 + \
_repl4*_repl6)*gS*ZAcbc(sqrt(2*_repl4 + 2*_repl5 + \
2*cospl1*l1*p)/sqrt(3)))/(l1^2*(_repl4 + _repl5 + \
2*cospl1*l1*p)*Zc(l1)*Zc(sqrt(_repl4 + _repl5 + 2*cospl1*l1*p)))\\nend\"\>"], \
"Output",
 CellChangeTimes->{
  3.974955424068762*^9, {3.9750621216605597`*^9, 3.975062140645183*^9}, {
   3.97506232652857*^9, 3.97506234098042*^9}, 3.975062848524881*^9, 
   3.9786807491030607`*^9},
 CellLabel->"Out[54]=",ExpressionUUID->"96437c62-3144-4292-94f0-1a61b41caac6"]
}, Open  ]],

