 CellChangeTimes->{{3.974955091194139*^9, 3.974955110742147*^9}, {
   3.9749551863902683`*^9, 3.974955207390588*^9}, 3.974955421266271*^9, {
   3.975062117688541*^9, 3.9750621394746943`*^9}, {3.9750623210821247`*^9, 
   3.975062339466655*^9}, {3.9750627755951*^9, 3.975062776350016*^9}, {
   3.978680725043457*^9, 3.978680741727203*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"fe57f41a-7330-4ba3-88c4-9f8b1d80e482"],

Cell[BoxData["\<\"auto DSEAA1Loop(const auto& l1, const auto& p, const auto& \
cospl1, const auto& gS, const auto& ZA, const auto& Zc, const auto& ZA3, \
const auto& ZAcbc)\\n{\\n  const auto _interp1 = ZA(l1);\\n  const auto \
_interp2 = ZA(sqrt(powr<2>(l1) - 2. * cospl1 * l1 * p + powr<2>(p)));\\n  \
const auto _interp3 = ZA3(0.816496580927726 * sqrt(powr<2>(l1) - cospl1 * l1 \
* p + powr<2>(p)));\\n  const auto _interp4 = ZAcbc(0.816496580927726 * \
sqrt(powr<2>(l1) - cospl1 * l1 * p + powr<2>(p)));\\n  const auto _interp5 = \
Zc(l1);\\n  const auto _interp6 = Zc(sqrt(powr<2>(l1) - 2. * cospl1 * l1 * p \
+ powr<2>(p)));\\n  const auto _den1 = powr<-2>(powr<2>(l1) - 2. * cospl1 * \
l1 * p + powr<2>(p));\\n  const auto _den2 = powr<-1>(powr<2>(l1) - 2. * \
cospl1 * l1 * p + powr<2>(p));\\n  const auto _cse1 = powr<-4>(l1);\\n  const \
auto _cse2 = powr<-2>(p);\\n  const auto _cse3 = -24. * cospl1 * l1 * \
powr<3>(p);\\n  const auto _cse4 = powr<-1>(_interp1);\\n  // clang-format \
off\\n  return 0.5 * fma(-32., powr<-1>(_cse2) * _cse4 * _den1 * \
powr<-1>(_interp2) * _interp3 * gS, fma(-1., _cse2 * _cse3 * _cse4 * _den1 * \
powr<-1>(_interp2) * _interp3 * gS, fma(2., _den2 * _interp4 * \
powr<-1>(_interp5) * powr<-1>(_interp6) * gS, fma(-2., _den2 * _interp4 * \
powr<-1>(_interp5) * powr<-1>(_interp6) * powr<2>(cospl1) * gS, fma(-12., \
_cse1 * powr<-2>(_cse2) * _cse4 * _den1 * powr<-1>(_interp2) * _interp3 * gS \
* powr<2>(l1), fma(12., _cse4 * _den1 * powr<-1>(_interp2) * _interp3 * \
powr<2>(cospl1) * gS * powr<2>(l1), fma(12., _cse1 * powr<-2>(_cse2) * _cse4 \
* _den1 * powr<-1>(_interp2) * _interp3 * powr<2>(cospl1) * gS * powr<2>(l1), \
fma(_cse1, _cse3 * _cse4 * _den1 * powr<-1>(_interp2) * _interp3 * \
powr<2>(cospl1) * gS * powr<2>(l1), fma(14., _cse1 * _cse4 * powr<2>(gS) * \
powr<2>(l1), fma(-2., _cse1 * _cse4 * powr<2>(cospl1) * powr<2>(gS) * \
powr<2>(l1), fma(28., _cse1 * powr<-1>(_cse2) * _cse4 * _den1 * \
powr<-1>(_interp2) * _interp3 * powr<2>(cospl1) * gS * powr<4>(l1), fma(4., \
_cse1 * powr<-1>(_cse2) * _cse4 * _den1 * powr<-1>(_interp2) * _interp3 * \
powr<4>(cospl1) * gS * powr<4>(l1), fma(-12., _cse1 * _cse4 * _den1 * \
powr<-1>(_interp2) * _interp3 * gS * powr<6>(l1), fma(-24., _cse1 * _cse2 * \
_cse4 * _den1 * powr<-1>(_interp2) * _interp3 * powr<3>(cospl1) * gS * \
powr<5>(l1) * powr<3>(p), fma(24., _cse1 * _cse2 * _cse4 * _den1 * \
powr<-1>(_interp2) * _interp3 * cospl1 * gS * powr<3>(l1) * powr<5>(p), \
0.)))))))))))))));\\n  // clang-format on\\n}\"\>"], "Output",
 CellChangeTimes->{
  3.974955424068762*^9, {3.9750621216605597`*^9, 3.975062140645183*^9}, {
   3.97506232652857*^9, 3.97506234098042*^9}, 3.975062848524881*^9, 
   3.978680749072611*^9, 3.994751318744849*^9, 3.994758127729248*^9, {
   3.9950815987845507`*^9, 3.9950816002469254`*^9}, 3.9950839388988113`*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"7f6fa1e9-5ad2-4522-bfce-c22213aaaf47"],

Cell[BoxData["\<\"function DSEAA1Loop(l1, p, cospl1, gS, ZA, Zc, ZA3, \
ZAcbc)\\n  _interp1 = ZA(l1)\\n  _interp2 = ZA(sqrt(l1^2 - 2*cospl1*l1*p + \
p^2))\\n  _interp3 = ZA3(sqrt(0.6666666666666666)*sqrt(l1^2 - cospl1*l1*p + \
p^2))\\n  _interp4 = ZAcbc(sqrt(0.6666666666666666)*sqrt(l1^2 - cospl1*l1*p + \
p^2))\\n  _interp5 = Zc(l1)\\n  _interp6 = Zc(sqrt(l1^2 - 2*cospl1*l1*p + \
p^2))\\n  _den1 = (l1^2 - 2*cospl1*l1*p + p^2)^(-2)\\n  _den2 = 1/(l1^2 - \
2*cospl1*l1*p + p^2)\\n  _cse1 = l1^(-4)\\n  _cse2 = p^(-2)\\n  _cse3 = \
-24*cospl1*l1*p^3\\n  _cse4 = 1/_interp1\\n  return \
fma(-32,(_cse4*_den1*_interp3*gS)/(_cse2*_interp2),fma(-1,(_cse2*_cse3*_cse4*_\
den1*_interp3*gS)/_interp2,fma(2,(_den2*_interp4*gS)/(_interp5*_interp6),fma(-\
2,(_den2*_interp4*cospl1^2*gS)/(_interp5*_interp6),fma(-12,(_cse1*_cse4*_den1*\
_interp3*gS*l1^2)/(_cse2^2*_interp2),fma(12,(_cse4*_den1*_interp3*cospl1^2*gS*\
l1^2)/_interp2,fma(12,(_cse1*_cse4*_den1*_interp3*cospl1^2*gS*l1^2)/(_cse2^2*_\
interp2),fma(_cse1,(_cse3*_cse4*_den1*_interp3*cospl1^2*gS*l1^2)/_interp2,fma(\
14,_cse1*_cse4*gS^2*l1^2,fma(-2,_cse1*_cse4*cospl1^2*gS^2*l1^2,fma(28,(_cse1*_\
cse4*_den1*_interp3*cospl1^2*gS*l1^4)/(_cse2*_interp2),fma(4,(_cse1*_cse4*_\
den1*_interp3*cospl1^4*gS*l1^4)/(_cse2*_interp2),fma(-12,(_cse1*_cse4*_den1*_\
interp3*gS*l1^6)/_interp2,fma(-24,(_cse1*_cse2*_cse4*_den1*_interp3*cospl1^3*\
gS*l1^5*p^3)/_interp2,fma(24,(_cse1*_cse2*_cse4*_den1*_interp3*cospl1*gS*l1^3*\
p^5)/_interp2,0)))))))))))))))/2.\\nend\"\>"], "Output",
 CellChangeTimes->{
  3.974955424068762*^9, {3.9750621216605597`*^9, 3.975062140645183*^9}, {
   3.97506232652857*^9, 3.97506234098042*^9}, 3.975062848524881*^9, 
   3.978680749072611*^9, 3.994751318744849*^9, 3.994758127729248*^9, {
   3.9950815987845507`*^9, 3.9950816002469254`*^9}, 3.9950839389240017`*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"2f62d077-3167-4cb4-ac68-798cb530749d"]
}, Open  ]],

