 RowBox[{
  RowBox[{"DSEA4", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FTakeDerivatives", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"FMakeDSE", "[", 
          RowBox[{"Setup", ",", 
           RowBox[{"A", "[", "i1", "]"}]}], "]"}], ",", 
