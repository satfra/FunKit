   3.9839696848234463`*^9, 3.983969793563738*^9, 3.983969836818819*^9, 
   3.9839699022377768`*^9, 3.9839699988688087`*^9, 3.9839701004310083`*^9, 
   3.9842997882229843`*^9, 3.994751098256805*^9},
 CellLabel->"Out[17]=",ExpressionUUID->"bec1edd3-2532-431d-a991-43da35255442"]
