Cell[CellGroupData[{

Cell["fRG", "Chapter",
 CellChangeTimes->{{3.953485007895423*^9, 3.9534850314273233`*^9}, {
   3.953526816409965*^9, 3.953526816792613*^9}, 3.953798801084491*^9, 
   3.9538004416146717`*^9, 
   3.953802271339385*^9},ExpressionUUID->"dd38567b-286f-4d29-bcc9-\
8e83dd406c31"],

Cell["\<\
In the following, we list as examples also the fRG flow equations for the \
Yang-Mills setup we defined.\
\>", "Text",
 CellChangeTimes->{{3.978681036527854*^9, 
  3.978681066318673*^9}},ExpressionUUID->"808f9fe5-4c97-4894-8081-\
7c7fad642db3"],

Cell["\<\
On a side - note, note that FTakeDerivatives automatically detects \
symmetries, e . g . for a three - point function:\
\>", "Text",
 CellChangeTimes->{{3.97868114267581*^9, 3.9786811777317457`*^9}, {
  3.978681392082032*^9, 
  3.97868139883459*^9}},ExpressionUUID->"d7d85c4e-f9d3-49fc-b6e9-\
a5905091f1a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fRGP3A", "=", 
   RowBox[{"FTakeDerivatives", "[", 
    RowBox[{"WetterichEquation", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"A", "[", "i1", "]"}], ",", 
       RowBox[{"A", "[", "i2", "]"}], ",", 
       RowBox[{"A", "[", "i3", "]"}]}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9786811815429277`*^9, 3.978681208078971*^9}, 
   3.994758246009376*^9},
 CellLabel->"In[40]:=",ExpressionUUID->"7054d400-d116-4b6a-92a2-7db089da96af"],

Cell["\<\
In any FEx[...] you may add as an annotation a rule called \
\[OpenCurlyDoubleQuote]Symmetries\[CloseCurlyDoubleQuote], which explains all \
possible permutations of external indices which affects the full diagram with \
a definite Factor (usually either 1 (symmetry) or -1 (antisymmetry)). \
FTakeDerivatives derives these symmetries always and annotates its result \
with them. Then, the diagrams are automatically simplified (i.e. identical \
ones can be identified) and put together, often considerably shortening the \
resulting expressions.
If you would like to turn off this behaviour, you can use \
FSetAutoBuildSymmetryList[False]\
\>", "Text",
 CellChangeTimes->{{3.978681213375868*^9, 
  3.978681385355147*^9}},ExpressionUUID->"6e85a361-8ac8-4020-b70e-\
285cf73b7fb8"],

Cell[CellGroupData[{

Cell["2-Point", "Section",
 CellChangeTimes->{{3.953656190978364*^9, 
  3.95365619218036*^9}},ExpressionUUID->"5771dcf9-95eb-4d1b-ad60-\
ea75407d8d77"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"fRGAA", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FTakeDerivatives", "[", 
        RowBox[{"WetterichEquation", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"A", "[", "i1", "]"}], ",", 
           RowBox[{"A", "[", "i2", "]"}]}], "}"}]}], "]"}], "//", 
       "FTruncate"}], "//", "FPlot"}], "//", "FRoute"}], "//", "FPrint"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9534859811565523`*^9, 3.953486009372175*^9}, {
   3.953486052691936*^9, 3.95348605314333*^9}, {3.953524779852734*^9, 
