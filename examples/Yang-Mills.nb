          RowBox[{
           RowBox[{"A", "[", "i4", "]"}], ",", 
           RowBox[{"A", "[", "i3", "]"}], ",", 
           RowBox[{"A", "[", "i2", "]"}]}], "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"\"\<Symmetries\>\"", "->", 
          RowBox[{"FMakeSymmetryList", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"A", "[", "i1", "]"}], ",", 
             RowBox[{"A", "[", "i2", "]"}], ",", 
             RowBox[{"A", "[", "i3", "]"}], ",", 
