Cell["\<\
This time, we will use a FORM rule to simplify expressions when tracing. For \
symmetric point projections, FunKit provides methods to make such rules:\
\>", "Text",
 CellChangeTimes->{{3.9750623717277317`*^9, 3.9750624245774107`*^9}, {
  3.978680809590477*^9, 
  3.978680818202866*^9}},ExpressionUUID->"4e99fa46-c019-48f6-81d4-\
f1c7ad9d917c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Framed", "@", 
  RowBox[{"MakeSPFormRule", "::", "usage"}]}], "\[IndentingNewLine]", 
 RowBox[{"SP3FormRule", "=", 
  RowBox[{"MakeSPFormRule", "[", 
   RowBox[{
    RowBox[{"{", "l1", "}"}], ",", "p", ",", 
    RowBox[{"{", 
     RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.953656287445446*^9, 3.953656313624571*^9}, {
   3.953656370716666*^9, 3.953656377012629*^9}, {3.953656644833166*^9, 
   3.9536566494645567`*^9}, {3.957326703057465*^9, 3.95732671314786*^9}, {
   3.975062368645904*^9, 3.975062368770144*^9}, 3.975062428261681*^9, {
   3.978681436019024*^9, 3.978681442159164*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"16afd84d-f214-4ae8-ba2a-57a724f43ab4"],

Cell[BoxData[
 FrameBox["\<\"MakeSPFormRule[{l1, l2, ...}, p, {p1, p2, ...}]\\nCreates a \
FORM rule for symmetric point momentum configuration.\\nThe first argument is \
a list of loop momenta {l1, l2, ...}.\\nThe second argument p is the average \
momentum scale.\\nThe third argument is a list of external leg momenta {p1, \
p2, ...}.\\nProjects all momenta to a symmetric configuration with average \
momentum p.\\nCrucial for evaluating loop integrals at the symmetric point \
for RG calculations.\"\>",
  StripOnInput->False]], "Output",
 CellChangeTimes->{
  3.9750624286122026`*^9, 3.975062852538554*^9, 3.978680824100988*^9, {
   3.978681438115781*^9, 3.978681442450879*^9}},
 CellLabel->"Out[78]=",ExpressionUUID->"35def580-3392-4075-bdb8-8b79e51ae020"],

Cell[BoxData[
 RowBox[{"{", "\<\"Vector p1,p2,p3, l1 ,p;\\nSymbol n;\\nAutoDeclare \
CFunction cos;\\nSet exMom : p1,p2,p3;\\nSet loopMom : l1;\\n\\n#define SPOrd \
\\\"3\\\"\\n\\n*** project to the SP\\n#procedure ProjSP()\\nid \
FTxsp(p1?exMom,p1?exMom)^-1 = FTxsp(p,p)^-1;\\nid FTxsp(p1?exMom,p1?exMom) = \
FTxsp(p,p);\\nid FTxsp(p1?exMom,p2?exMom)^-1 = \
(-FTxsp(p,p)/(`SPOrd'-1))^-1;\\nid FTxsp(p1?exMom,p2?exMom) = \
-FTxsp(p,p)/(`SPOrd'-1);\\n\\nid FTxsp(p1?exMom,l1?loopMom)^-1 = \
(sqrt(FTxsp(p,p))*sqrt(FTxsp(l1,l1))*cos(p1,l1))^-1;\\nid \
FTxsp(p1?exMom,l1?loopMom) = \
(sqrt(FTxsp(p,p))*sqrt(FTxsp(l1,l1))*cos(p1,l1));\\n#endprocedure\\n\\n#call \
SCALL(ProjSP)\\n.sort\"\>", "}"}]], "Output",
 CellChangeTimes->{
  3.9750624286122026`*^9, 3.975062852538554*^9, 3.978680824100988*^9, {
   3.978681438115781*^9, 3.978681442452457*^9}},
 CellLabel->"Out[79]=",ExpressionUUID->"28ac094e-a0f6-4f9f-8b40-44684f2b2a94"]
}, Open  ]],

Cell["\<\
In the above, SCALL is a predefined routine to recursively apply a method to \
arguments. Even if you do not understand FORM, you can still use it to \
project to the symmetric  point when tracing as in the following:\
\>", "Text",
 CellChangeTimes->{{3.9750624464859867`*^9, 3.975062468241482*^9}, {
  3.9786808341387367`*^9, 
  3.978680870450523*^9}},ExpressionUUID->"69165eb0-0546-4369-baf6-\
83218fb53ead"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"projectorAcbc", "=", 
   RowBox[{"FTerm", "[", 
    RowBox[{"TBGetProjector", "[", 
     RowBox[{"\"\<Acbc\>\"", ",", "1", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i3", ",", "i2", ",", "i1"}], "}"}], "/.", 
       RowBox[{
        RowBox[{"DSEAcbc", "[", "\"\<1-Loop\>\"", "]"}], "[", 
        "\"\<ExternalIndices\>\"", "]"}]}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DSEAcbcProjected", "=", 
   RowBox[{
    RowBox[{"projectorAcbc", "**", 
     RowBox[{
      RowBox[{"DSEAcbc", "[", "\"\<1-Loop\>\"", "]"}], "[", 
      "\"\<Expression\>\"", "]"}]}], "/.", 
    RowBox[{"FMakeDiagrammaticRules", "[", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DSEAcbcResult", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FormTrace", "[", 
        RowBox[{"DSEAcbcProjected", ",", 
         RowBox[{"{", "}"}], ",", "SP3FormRule"}], "]"}], "//", 
       "dressingRules"}], "//", "SP3Project"}], "//", "SPParam"}], "//", 
    "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.975062485246743*^9, 3.975062508074699*^9}, {
  3.975062556641778*^9, 3.975062559042222*^9}, {3.975062869596084*^9, 
  3.975062870458404*^9}, {3.975063067050036*^9, 3.975063071394781*^9}, {
  3.9786808796633167`*^9, 3.97868092417494*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"aadd853c-2605-4344-b3bb-c1861400903d"],

Cell["\<\
To create C++ code, we would now like to insert some user-defined code to \
define the angles between the loop momentum l1 and the external momenta p1:\
\>", "Text",
 CellChangeTimes->{{3.978680942627459*^9, 
  3.97868096866673*^9}},ExpressionUUID->"83b76223-3df9-48fe-b008-\
ad24bb7b3396"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Options", "[", "\"\<MakeCppFunction\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.975062586754212*^9, 3.975062591069436*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"e465f029-210d-42ce-b899-aaf0c89bf65a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Return\"\>", "\[Rule]", "\<\"auto\"\>"}], ",", 
   RowBox[{"\<\"Parameters\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"Name\"\>", "\[Rule]", "\<\"function\"\>"}], ",", 
   RowBox[{"\<\"Prefix\"\>", "\[Rule]", "\<\"\"\>"}], ",", 
   RowBox[{"\<\"Suffix\"\>", "\[Rule]", "\<\"\"\>"}], ",", 
   RowBox[{"\<\"CodeParser\"\>", "\[Rule]", "\<\"Cpp\"\>"}], ",", 
   RowBox[{"\<\"Body\"\>", "\[Rule]", "\<\"\"\>"}], ",", 
   RowBox[{"\<\"Class\"\>", "\[Rule]", "\<\"\"\>"}], ",", 
   RowBox[{"\<\"Templates\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.97506259136318*^9, 3.978680970262189*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"cea6f7e0-231c-4f9f-a15d-3e48ada1e958"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MakeCppFunction", "[", 
  RowBox[{
   RowBox[{"Total", "@", "DSEAcbcResult"}], ",", "\[IndentingNewLine]", 
   RowBox[{"\"\<Name\>\"", "->", "\"\<DSEAcbc1Loop\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"\"\<Parameters\>\"", "->", 
    RowBox[{"{", 
     RowBox[{
     "\"\<l1\>\"", ",", "\"\<p\>\"", ",", "\"\<cos1\>\"", ",", "\"\<cos2\>\"",
       ",", "\"\<gS\>\"", ",", "\"\<ZA\>\"", ",", "\"\<Zc\>\"", ",", 
      "\"\<ZA3\>\"", ",", "\"\<ZAcbc\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
   "\"\<Body\>\"", "->", 
    "\"\<// This is user-defined \nconst double cosl1p1 = cos1;\nconst double \
cosl1p2 = ((-1.) * (cos1) + (sqrt(3. + (-3.) * (powr<2>(cos1)))) * (cos2)) * \
(0.5);\nconst double cosl1p3 = ((-1.) * (cos1) + (-1.) * ((sqrt(3. + (-3.) * \
(powr<2>(cos1)))) * (cos2))) * (0.5);\n// This is not user-defined \>\""}]}], 
  "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.9537929488967257`*^9, {3.953793523560779*^9, 3.953793569668296*^9}, {
   3.95379361026025*^9, 3.953793627743491*^9}, {3.957326799322144*^9, 
   3.957326799964938*^9}, {3.957340481355226*^9, 3.957340481730839*^9}, {
   3.9611261190368767`*^9, 3.9611261332918177`*^9}, 3.975062432698194*^9, 
   3.975062472669919*^9, {3.9750625416442327`*^9, 3.975062548633524*^9}, {
   3.975062581089663*^9, 3.975062687553596*^9}, {3.975062724514451*^9, 
   3.975062767629797*^9}, {3.975063089059515*^9, 3.975063105602552*^9}, 
   3.978680984212031*^9},
 CellLabel->"In[63]:=",ExpressionUUID->"ee1ebc1b-f8df-47fe-84c8-254d49a5d461"],

Cell[BoxData["\<\"auto DSEAcbc1Loop(const auto &l1, const auto &p, const auto \
&cos1, const auto &cos2, const auto &gS, const auto &ZA,\\n                  \
const auto &Zc, const auto &ZA3, const auto &ZAcbc)\\n{\\n  // This is \
user-defined\\n  const double cosl1p1 = cos1;\\n  const double cosl1p2 = \
((-1.) * (cos1) + (sqrt(3. + (-3.) * (powr<2>(cos1)))) * (cos2)) * (0.5);\\n  \
const double cosl1p3 = ((-1.) * (cos1) + (-1.) * ((sqrt(3. + (-3.) * \
(powr<2>(cos1)))) * (cos2))) * (0.5);\\n  // This is not user-defined\\n  \
const auto _repl1 = Zc(sqrt(powr<2>(l1) + (2.) * ((cosl1p1) * ((l1) * (p))) + \
powr<2>(p)));\\n  const auto _repl2 = ZA(l1);\\n  const auto _repl3 = \
powr<2>(p);\\n  const auto _repl4 = powr<2>(l1);\\n  const auto _repl5 = \
powr<2>(cosl1p2);\\n  const auto _repl6 = powr<3>(l1);\\n  const auto _repl7 \
= powr<3>(p);\\n  const auto _repl8 = powr<-2>(l1);\\n  return (0.5) *\\n     \
        ((-3.) * (_repl7) + (-2.) * ((_repl6) * (cosl1p2)) + (-5.) * \
((_repl3) * ((cosl1p2) * (l1))) +\\n              (-6.) * ((_repl4) * (p)) + \
(2.) * ((_repl4) * ((_repl5) * (p))) +\\n              (2.) * ((2.) * \
((cosl1p2) * (l1)) + (7.) * (p)) * ((powr<3>(cosl1p1)) * ((l1) * (p))) +\\n   \
           (2.) *\\n                  ((2.) * (_repl6 + (6.) * ((_repl3) * \
(l1))) * (cosl1p2) + (3.) * (_repl3 + (2.) * (_repl4)) * (p)) *\\n            \
      (powr<2>(cosl1p1)) +\\n              ((2. + (-4.) * (_repl5)) * \
(_repl6) + (6.) * ((_repl7) * (cosl1p2)) +\\n               (_repl3) * (-7. + \
(10.) * (_repl5)) * (l1) +\\n               (2.) * (5. + (-2.) * (_repl5)) * \
((_repl4) * ((cosl1p2) * (p)))) *\\n                  (cosl1p1)) *\\n         \
    ((powr<-1>(_repl1)) *\\n              ((powr<-1>(_repl2)) *\\n            \
   ((_repl8) *\\n                ((gS) *\\n                 ((p) * \
((powr<-1>(_repl3 + _repl4 + (2.) * ((cosl1p1) * ((l1) * (p))))) *\\n         \
                ((powr<-2>(_repl3 + _repl4 + (2.) * (cosl1p1 + cosl1p2) * \
((l1) * (p)))) *\\n                          ((powr<-1>(ZA(sqrt(_repl3 + \
_repl4 + (2.) * (cosl1p1 + cosl1p2) * ((l1) * (p)))))) *\\n                   \
        ((ZA3((0.816496580927726) * (sqrt(_repl3 + _repl4 + (l1) * (cosl1p1 + \
cosl1p2) * (p))))) *\\n                            (ZAcbc(sqrt(_repl3 + \
