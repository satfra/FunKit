       RowBox[{"-", "1"}], "+", 
       SuperscriptBox["cospl1", "2"]}], ")"}], " ", "gS", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        SuperscriptBox["l1", "4"]}], "+", 
       RowBox[{"6", " ", "cospl1", " ", 
        SuperscriptBox["l1", "3"], " ", "p"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"8", "+", 
          SuperscriptBox["cospl1", "2"]}], ")"}], " ", 
        SuperscriptBox["l1", "2"], " ", 
        SuperscriptBox["p", "2"]}], "+", 
