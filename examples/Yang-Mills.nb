          RowBox[{"Rdot", ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", "cb"}], "}"}], ",", "1", ",", 
           RowBox[{"{", 
            RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], ":>", 
