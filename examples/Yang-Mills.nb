Cell["\<\
The FormTracer output contains certain functions for expressing scalar \
products, which we also convert to explicit variables.\
\>", "Text",
 CellChangeTimes->{{3.978679709275914*^9, 
  3.978679774682839*^9}},ExpressionUUID->"b71e2594-3194-4653-9855-\
780bae78fcd0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PropParam", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{"UseLorentzLinearity", "[", "expr", "]"}], "//.", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lf1", "->", "l1"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "FunKit", " ", "marks", " ", "purely", " ", "fermionic", " ", "loop", 
         " ", "momenta", " ", "with", " ", "an", " ", 
         RowBox[{"f", ".", " ", "This"}], " ", "is", " ", "useful", " ", 
         "for", " ", "finite", " ", "T", " ", "calculations"}], ",", " ", 
        RowBox[{
        "where", " ", "Matsubara", " ", "frequencies", " ", "are", " ", 
         "shifted", " ", "by", " ", 
         RowBox[{"\[Pi]T", "!"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"p1", ",", "p1"}], "]"}], "->", 
       SuperscriptBox["p", "2"]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l2", ",", "l2"}], "]"}], "->", 
       SuperscriptBox["l2", "2"]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l1", ",", "l1"}], "]"}], "->", 
       SuperscriptBox["l1", "2"]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l1", ",", "p1"}], "]"}], "->", 
       RowBox[{"l1", " ", "p", " ", 
        RowBox[{"cos", "[", 
         RowBox[{"p", ",", "l1"}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l2", ",", "p1"}], "]"}], "->", 
       RowBox[{"l2", " ", "p", " ", 
        RowBox[{"cos", "[", 
         RowBox[{"p", ",", "l2"}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l1", ",", "l2"}], "]"}], "->", 
       RowBox[{"l1", " ", "l2", " ", 
        RowBox[{"cos", "[", 
         RowBox[{"l1", ",", "l2"}], "]"}]}]}], ",", 
      RowBox[{
       SqrtBox[
        SuperscriptBox["a_", "2"]], ":>", "a"}], ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["a_", "2"], ")"}], 
        FractionBox["n_", "2"]], ":>", 
       SuperscriptBox["a", "n"]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p", ",", "l1"}], "]"}], ":>", "cospl1"}], ",", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p", ",", "l1"}], "]"}], ":>", "cospl2"}]}], 
     "\[IndentingNewLine]", "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SPParam", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{"UseLorentzLinearity", "[", "expr", "]"}], "//.", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"lf1", "->", "l1"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "FunKit", " ", "marks", " ", "purely", " ", "fermionic", " ", "loop", 
         " ", "momenta", " ", "with", " ", "an", " ", 
         RowBox[{"f", ".", " ", "This"}], " ", "is", " ", "useful", " ", 
         "for", " ", "finite", " ", "T", " ", "calculations"}], ",", " ", 
        RowBox[{
        "where", " ", "Matsubara", " ", "frequencies", " ", "are", " ", 
         "shifted", " ", "by", " ", 
         RowBox[{"\[Pi]T", "!"}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"p", ",", "p"}], "]"}], "->", 
       SuperscriptBox["p", "2"]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l1", ",", "l1"}], "]"}], "->", 
       SuperscriptBox["l1", "2"]}], ",", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"l1", ",", "l2"}], "]"}], "->", 
       RowBox[{"l1", " ", "l2", " ", 
        RowBox[{"cos", "[", 
         RowBox[{"l1", ",", "l2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"sp", "[", 
        RowBox[{"p", ",", "l1"}], "]"}], "->", 
       RowBox[{"l1", " ", "p", " ", 
        RowBox[{"cos", "[", 
         RowBox[{"p", ",", "l2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       SqrtBox[
        SuperscriptBox["a_", "2"]], ":>", "a"}], ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["a_", "2"], ")"}], 
        FractionBox["n_", "2"]], ":>", 
       SuperscriptBox["a", "n"]}], ",", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         SuperscriptBox["a_", "2"], ")"}], 
        RowBox[{"n_", "/", "2"}]], ":>", 
       SuperscriptBox["a", "n"]}], ",", 
      RowBox[{
       RowBox[{"Power", "[", 
        RowBox[{
         RowBox[{"Power", "[", 
          RowBox[{"l1_", ",", "2"}], "]"}], ",", 
         RowBox[{"Rational", "[", 
          RowBox[{"n_", ",", "2"}], "]"}]}], "]"}], ":>", 
       SuperscriptBox["l1", "n"]}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p1", ",", "l1"}], "]"}], ":>", "cosl1p1"}], ",", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p2", ",", "l1"}], "]"}], ":>", "cosl1p2"}], ",", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p3", ",", "l1"}], "]"}], ":>", "cosl1p3"}], ",", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p4", ",", "l1"}], "]"}], ":>", "cosl1p4"}]}], 
     "\[IndentingNewLine]", "}"}]}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{
  3.97867970541567*^9, {3.9786797859278917`*^9, 3.978679861788776*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"f43460c3-c485-462c-9409-533d01c074c6"],

Cell["\<\
Finally, we just define a few projectors onto symmetric points and set the \
number of colours to 3.\
\>", "Text",
 CellChangeTimes->{{3.978679862876096*^9, 
  3.978679893750785*^9}},ExpressionUUID->"3065cf40-b65b-4bce-9bf7-\
af765e8e8f8c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SP3Project", "=", 
   RowBox[{
    RowBox[{"TBProjectToSymmetricPoint", "[", 
     RowBox[{"#", ",", "l1", ",", "p", ",", "p1", ",", "p2", ",", "p3"}], 
     "]"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SP4Project", "=", 
   RowBox[{
    RowBox[{"TBProjectToSymmetricPoint", "[", 
     RowBox[{
     "#", ",", "l1", ",", "p", ",", "p1", ",", "p2", ",", "p3", ",", "p4"}], 
     "]"}], "&"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"SetNc", "[", "3", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"k", ">", "0"}], "&&", 
    RowBox[{"p", ">", "0"}], "&&", 
    RowBox[{"l1", ">", "0"}], "&&", 
    RowBox[{
     RowBox[{"-", "1"}], "<", "cos1", "<", 
     RowBox[{"1", "-", "1"}], "<", "cos2", "<", "1"}], "&&", 
    RowBox[{
     RowBox[{"-", "1"}], "<", "cos3", "<", "1"}]}]}], ";"}]}], "Input",
 InitializationCell->True,
 CellChangeTimes->{3.978679872066907*^9},
 CellLabel->"In[12]:=",ExpressionUUID->"8735de70-7646-46b5-bf4e-58cbea4460bc"]
}, Closed]],

Cell[CellGroupData[{

Cell["DSE", "Chapter",
 CellChangeTimes->{{3.953485007895423*^9, 3.9534850314273233`*^9}, {
  3.953696331366856*^9, 
  3.953696331417049*^9}},ExpressionUUID->"e79e5063-ba32-4e83-9560-\
a0f7aafe4215"],

Cell[CellGroupData[{

Cell["2-Point", "Section",
 CellChangeTimes->{{3.953656190978364*^9, 
  3.95365619218036*^9}},ExpressionUUID->"ebeff864-274c-4152-ae48-\
8f8265728dac"],

Cell["\<\
As a first example, let' s derive the gluon' s gap equation . We create the \
DSE for the gluon using MakeDSE[A[i1]] (although we could also implement this \
by hand, it is given for convenience by FunKit).
Note that the output is not yet truncated: Instead of explicit fields \
(A,cb,c) there are still AnyField in many places.\
\>", "Text",
 CellChangeTimes->{{3.978679907283702*^9, 3.9786799701309433`*^9}, {
  3.97868006129839*^9, 3.9786801261826353`*^9}, {3.994757775488578*^9, 
  3.9947577761286707`*^9}},ExpressionUUID->"4b3b7d65-2e24-4eab-b49b-\
01aa25c5123c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dseA", " ", "=", " ", 
  RowBox[{
   RowBox[{"FMakeDSE", "[", 
    RowBox[{"A", "[", "i1", "]"}], "]"}], "//", "FPrint"}]}]], "Input",
