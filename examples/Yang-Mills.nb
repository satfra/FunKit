Cell["\<\
Next, we project and trace out only the 1-Loop part of the gluon gap \
equation. You can do the same to the 2-Loop parts, which takes considerably \
more time.
We use here the function FMakeDiagrammaticRules to create a list of \
replacement rules for the tensor bases of all vertices, as specified in the \
setup.\
\>", "Text",
 CellChangeTimes->{{3.975061436188633*^9, 3.975061472061182*^9}, {
  3.978680523886492*^9, 3.9786805379104633`*^9}, {3.978680606298732*^9, 
  3.978680649486586*^9}},ExpressionUUID->"f703d548-f811-48cd-9d5a-\
8cc187be90c0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"projectorAA", "=", 
  RowBox[{"FTerm", "[", 
   RowBox[{"TBGetProjector", "[", 
    RowBox[{"\"\<AA\>\"", ",", "1", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i1", ",", "i2"}], "}"}], "/.", 
      RowBox[{
       RowBox[{"DSEAA", "[", "\"\<1-Loop\>\"", "]"}], 
