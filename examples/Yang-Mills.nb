      ",", "\"\<ZA3\>\"", ",", "\"\<ZAcbc\>\""}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"MakeJuliaFunction", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "@", "DSEAAResult"}], "/.", 
    RowBox[{"\[Xi]", "->", "0"}]}], ",", 
   RowBox[{"\"\<Name\>\"", "->", "\"\<DSEAA1Loop\>\""}], ",", 
   RowBox[{"\"\<Parameters\>\"", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<l1\>\"", ",", "\"\<p\>\"", ",", "\"\<cospl1\>\"", 
      ",", "\"\<gS\>\"", ",", "\"\<ZA\>\"", ",", "\"\<Zc\>\"", 
