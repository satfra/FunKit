Cell["\<\
This time, we will use a FORM rule to simplify expressions when tracing. For \
symmetric point projections, FunKit provides methods to make such rules:\
\>", "Text",
 CellChangeTimes->{{3.9750623717277317`*^9, 3.9750624245774107`*^9}, {
  3.978680809590477*^9, 
  3.978680818202866*^9}},ExpressionUUID->"4e99fa46-c019-48f6-81d4-\
f1c7ad9d917c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Framed", "@", 
  RowBox[{"FMakeSPFormRule", "::", "usage"}]}], "\[IndentingNewLine]", 
 RowBox[{"SP3FormRule", "=", 
  RowBox[{"FMakeSPFormRule", "[", 
   RowBox[{
    RowBox[{"{", "l1", "}"}], ",", "p", ",", 
    RowBox[{"{", 
     RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.953656287445446*^9, 3.953656313624571*^9}, {
   3.953656370716666*^9, 3.953656377012629*^9}, {3.953656644833166*^9, 
   3.9536566494645567`*^9}, {3.957326703057465*^9, 3.95732671314786*^9}, {
   3.975062368645904*^9, 3.975062368770144*^9}, 3.975062428261681*^9, {
   3.978681436019024*^9, 3.978681442159164*^9}, {3.99475133732797*^9, 
   3.994751339231823*^9}},
 CellLabel->"In[31]:=",ExpressionUUID->"16afd84d-f214-4ae8-ba2a-57a724f43ab4"],

Cell[BoxData[
 FrameBox["\<\"FMakeSPFormRule[{l1, l2, ...}, p, {p1, p2, ...}]\\nCreates a \
FORM rule for symmetric point momentum configuration.\\nThe first argument is \
a list of loop momenta {l1, l2, ...}.\\nThe second argument p is the average \
momentum scale.\\nThe third argument is a list of external leg momenta {p1, \
p2, ...}.\\nProjects all momenta to a symmetric configuration with average \
momentum p.\\nCrucial for evaluating loop integrals at the symmetric point \
for RG calculations.\"\>",
  StripOnInput->False]], "Output",
 CellChangeTimes->{
  3.9750624286122026`*^9, 3.975062852538554*^9, 3.978680824100988*^9, {
   3.978681438115781*^9, 3.978681442450879*^9}, 3.994751339845071*^9, 
   3.994754901950654*^9, 3.994758132589653*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"d68ef807-c3dc-49be-ba2c-ed6124b581e7"],

Cell[BoxData[
 RowBox[{"{", "\<\"Vector p1,p2,p3, l1 ,p;\\nSymbol n;\\nAutoDeclare \
CFunction cos;\\nSet exMom : p1,p2,p3;\\nSet loopMom : l1;\\n\\n#define SPOrd \
\\\"3\\\"\\n\\n*** project to the SP\\n#procedure ProjSP()\\nid \
FTxsp(p1?exMom,p1?exMom)^-1 = FTxsp(p,p)^-1;\\nid FTxsp(p1?exMom,p1?exMom) = \
FTxsp(p,p);\\nid FTxsp(p1?exMom,p2?exMom)^-1 = \
(-FTxsp(p,p)/(`SPOrd'-1))^-1;\\nid FTxsp(p1?exMom,p2?exMom) = \
-FTxsp(p,p)/(`SPOrd'-1);\\n\\nid FTxsp(p1?exMom,l1?loopMom)^-1 = \
(sqrt(FTxsp(p,p))*sqrt(FTxsp(l1,l1))*cos(p1,l1))^-1;\\nid \
FTxsp(p1?exMom,l1?loopMom) = \
(sqrt(FTxsp(p,p))*sqrt(FTxsp(l1,l1))*cos(p1,l1));\\n\\n#endprocedure\\n\\n#\
call SCALL(ProjSP)\\n.sort\"\>", "}"}]], "Output",
 CellChangeTimes->{
  3.9750624286122026`*^9, 3.975062852538554*^9, 3.978680824100988*^9, {
   3.978681438115781*^9, 3.978681442450879*^9}, 3.994751339845071*^9, 
   3.994754901950654*^9, 3.994758132590435*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"5946a8a4-8081-4610-8189-1a668d996e44"]
}, Open  ]],

Cell["\<\
In the above, SCALL is a predefined routine to recursively apply a method to \
arguments. Even if you do not understand FORM, you can still use it to \
project to the symmetric  point when tracing as in the following:\
\>", "Text",
 CellChangeTimes->{{3.9750624464859867`*^9, 3.975062468241482*^9}, {
  3.9786808341387367`*^9, 
  3.978680870450523*^9}},ExpressionUUID->"69165eb0-0546-4369-baf6-\
83218fb53ead"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"projectorAcbc", "=", 
   RowBox[{"FTerm", "[", 
    RowBox[{"TBGetProjector", "[", 
     RowBox[{"\"\<Acbc\>\"", ",", "1", ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i3", ",", "i2", ",", "i1"}], "}"}], "/.", 
       RowBox[{
        RowBox[{"DSEAcbc", "[", "\"\<1-Loop\>\"", "]"}], 
        "[", "\"\<ExternalIndices\>\"", "]"}]}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DSEAcbcProjected", "=", 
   RowBox[{
    RowBox[{"projectorAcbc", "**", 
     RowBox[{
      RowBox[{"DSEAcbc", "[", "\"\<1-Loop\>\"", "]"}], 
      "[", "\"\<Expression\>\"", "]"}]}], "/.", 
    RowBox[{"FMakeDiagrammaticRules", "[", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DSEAcbcResult", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FormTrace", "[", 
        RowBox[{"DSEAcbcProjected", ",", 
         RowBox[{"{", "}"}], ",", "SP3FormRule"}], "]"}], "//", 
       "dressingRules"}], "//", "SP3Project"}], "//", "SPParam"}], "//", 
    "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.975062485246743*^9, 3.975062508074699*^9}, {
  3.975062556641778*^9, 3.975062559042222*^9}, {3.975062869596084*^9, 
  3.975062870458404*^9}, {3.975063067050036*^9, 3.975063071394781*^9}, {
  3.9786808796633167`*^9, 3.97868092417494*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"aadd853c-2605-4344-b3bb-c1861400903d"],

Cell[BoxData[""], "Input",ExpressionUUID->"3bd21b98-1543-4216-87b9-5fd8a6a42dc7"],

Cell["\<\
To create C++ code, we would now like to insert some user-defined code to \
define the angles between the loop momentum l1 and the external momenta p1:\
\>", "Text",
 CellChangeTimes->{{3.978680942627459*^9, 
  3.97868096866673*^9}},ExpressionUUID->"83b76223-3df9-48fe-b008-\
ad24bb7b3396"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Options", "[", "\"\<MakeCppFunction\>\"", "]"}]], "Input",
 CellChangeTimes->{{3.975062586754212*^9, 3.975062591069436*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"e465f029-210d-42ce-b899-aaf0c89bf65a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\<\"Return\"\>", "\[Rule]", "\<\"auto\"\>"}], ",", 
   RowBox[{"\<\"Parameters\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"Name\"\>", "\[Rule]", "\<\"function\"\>"}], ",", 
   RowBox[{"\<\"Prefix\"\>", "\[Rule]", "\<\"\"\>"}], ",", 
   RowBox[{"\<\"Suffix\"\>", "\[Rule]", "\<\"\"\>"}], ",", 
   RowBox[{"\<\"CodeParser\"\>", "\[Rule]", "\<\"Cpp\"\>"}], ",", 
   RowBox[{"\<\"Body\"\>", "\[Rule]", "\<\"\"\>"}], ",", 
   RowBox[{"\<\"Class\"\>", "\[Rule]", "\<\"\"\>"}], ",", 
   RowBox[{"\<\"Templates\"\>", "\[Rule]", 
    RowBox[{"{", "}"}]}], ",", 
   RowBox[{"\<\"ReturnTransform\"\>", "\[Rule]", "Identity"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.97506259136318*^9, 3.978680970262189*^9, 
  3.994751354581379*^9, 3.9947549106778097`*^9, 3.99475813707167*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"b4fa9c96-985d-4580-9b6f-cfacfd99c09e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"MakeCppFunction", "[", 
  RowBox[{
   RowBox[{"Total", "@", "DSEAcbcResult"}], ",", "\[IndentingNewLine]", 
   RowBox[{"\"\<Name\>\"", "->", "\"\<DSEAcbc1Loop\>\""}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"\"\<Parameters\>\"", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<l1\>\"", ",", "\"\<p\>\"", ",", "\"\<cos1\>\"", 
      ",", "\"\<cos2\>\"", ",", "\"\<gS\>\"", ",", "\"\<ZA\>\"", 
      ",", "\"\<Zc\>\"", ",", "\"\<ZA3\>\"", ",", "\"\<ZAcbc\>\""}], "}"}]}], 
   ",", "\[IndentingNewLine]", 
   RowBox[{"\"\<Body\>\"", 
    "->", "\"\<// This is user-defined \nconst double cosl1p1 = cos1;\nconst \
double cosl1p2 = ((-1.) * (cos1) + (sqrt(3. + (-3.) * (powr<2>(cos1)))) * \
(cos2)) * (0.5);\nconst double cosl1p3 = ((-1.) * (cos1) + (-1.) * ((sqrt(3. \
+ (-3.) * (powr<2>(cos1)))) * (cos2))) * (0.5);\n// This is not user-defined \
\>\""}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{
  3.9537929488967257`*^9, {3.953793523560779*^9, 3.953793569668296*^9}, {
