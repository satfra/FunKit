           RowBox[{"RB", "[", 
            RowBox[{
             SuperscriptBox["k", "2"], ",", 
             RowBox[{"sp", "[", 
              RowBox[{"p2", ",", "p2"}], "]"}]}], "]"}], 
           RowBox[{"(", 
