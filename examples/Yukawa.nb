Cell["\<\
Quark two-point flow equation. The derivative list uses the {Psi, Psibar} \
ordering of the truncation.\
\>", "Text",ExpressionUUID->"79a25c98-3c1f-4fdf-9ea1-32ee5f8ec159"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"fRGQuark2P", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FTakeDerivatives", "[", 
        RowBox[{"WetterichEquation", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Psi", "[", "i1", "]"}], ",", 
           RowBox[{"Psibar", "[", "i2", "]"}]}], "}"}]}], "]"}], "//", 
