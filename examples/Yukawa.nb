Cell[BoxData[
 RowBox[{
  RowBox[{"fRG2P", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FTakeDerivatives", "[", 
        RowBox[{"WetterichEquation", ",", 
         RowBox[{"{", 
