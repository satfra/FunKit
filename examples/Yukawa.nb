Cell[TextData[{
 "The mesons sigma and pi are commuting fields; the quarks psi and psibar are \
Grassmann fields. The truncation lists the meson self-interactions, the quark \
two-point function, and the two Yukawa vertices. We envisage here an \
interation as ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     OverscriptBox["\[Psi]", "_"], "(", 
     RowBox[{"\[Sigma]", "+", 
      RowBox[{"\[ImaginaryI]", " ", 
       SubscriptBox["\[Gamma]", "5"], "\[Tau]", " ", "\[Pi]"}]}], ")"}], 
    "\[Psi]"}], TraditionalForm]],ExpressionUUID->
  "92f670fa-5a8c-4992-aedc-652456720507"],
 "\nWe also allow for \[Sigma] to have a finite expectation value."
}], "Text",
 CellChangeTimes->{{3.988893079579464*^9, 3.9888931873054028`*^9}, {
  3.988893469015609*^9, 
  3.988893477307561*^9}},ExpressionUUID->"f2f6b266-cf08-40e7-8107-\
a857c8f9932d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fields", " ", "=", " ", 
    RowBox[{"<|", "\n", "    ", 
     RowBox[{
      RowBox[{"\"\<Commuting\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Sigma]", "[", "p", "]"}], ",", " ", 
         RowBox[{"\[CapitalPi]", "[", 
          RowBox[{"p", ",", " ", 
           RowBox[{"{", "f", "}"}]}], "]"}]}], "}"}]}], ",", "\n", "    ", 
      RowBox[{"\"\<Grassmann\>\"", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Psibar", "[", 
           RowBox[{"p", ",", " ", 
            RowBox[{"{", "a", "}"}]}], "]"}], ",", " ", 
          RowBox[{"Psi", "[", 
           RowBox[{"p", ",", " ", 
            RowBox[{"{", "a", "}"}]}], "]"}]}], "}"}], "}"}]}]}], "\n", 
     "|>"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"truncation", " ", "=", " ", 
    RowBox[{"<|", "\n", "    ", 
     RowBox[{
      RowBox[{"GammaN", " ", "->", " ", 
       RowBox[{"{", "\n", "        ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"meson", " ", "2"}], "-", "point"}], " ", "*)"}], "\n", 
        "        ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Sigma]", ",", " ", "\[Sigma]"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[CapitalPi]", ",", " ", "\[CapitalPi]"}], "}"}], ",", 
         "\n", "        ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"quark", " ", "2"}], "-", "point"}], " ", "*)"}], "\n", 
         "        ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar"}], "}"}], ",", "\n", "        ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"meson", " ", "3"}], "-", "point"}], " ", "*)"}], "\n", 
         "        ", 
         RowBox[{"{", 
          RowBox[{"\[Sigma]", ",", " ", "\[Sigma]", ",", " ", "\[Sigma]"}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "\[Sigma]", ",", " ", "\[CapitalPi]", ",", " ", "\[CapitalPi]"}], 
          "}"}], ",", "\n", "        ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"meson", " ", "4"}], "-", "point"}], " ", "*)"}], "\n", 
         "        ", 
         RowBox[{"{", 
          RowBox[{
          "\[Sigma]", ",", " ", "\[Sigma]", ",", " ", "\[Sigma]", ",", " ", 
           "\[Sigma]"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "\[CapitalPi]", ",", " ", "\[CapitalPi]", ",", " ", "\[CapitalPi]", 
           ",", " ", "\[CapitalPi]"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
          "\[Sigma]", ",", " ", "\[Sigma]", ",", " ", "\[CapitalPi]", ",", 
           " ", "\[CapitalPi]"}], "}"}], ",", "\n", "        ", 
         RowBox[{"(*", " ", 
          RowBox[{"Yukawa", " ", 
           RowBox[{"vertices", ":", " ", 
            RowBox[{"{", 
             RowBox[{"Psi", ",", " ", "Psibar", ",", " ", "boson"}], 
             "}"}]}]}], " ", "*)"}], "\n", "        ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar", ",", " ", "\[Sigma]"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar", ",", " ", "\[CapitalPi]"}], 
          "}"}]}], "\n", "    ", "}"}]}], ",", "\n", "    ", 
      RowBox[{"Propagator", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Sigma]", ",", " ", "\[Sigma]"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[CapitalPi]", ",", " ", "\[CapitalPi]"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar"}], "}"}]}], "}"}]}], ",", "\n", 
      "    ", 
      RowBox[{"Rdot", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Sigma]", ",", " ", "\[Sigma]"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[CapitalPi]", ",", " ", "\[CapitalPi]"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar"}], "}"}]}], "}"}]}], ",", "\n", 
      "    ", 
      RowBox[{"Field", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{"{", "\[Sigma]", "}"}], "}"}]}], ",", "\n", "    ", 
      RowBox[{"S", " ", "->", " ", 
       RowBox[{"{", "\n", "        ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"meson", " ", "2"}], "-", "point"}], " ", "*)"}], "\n", 
        "        ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Sigma]", ",", " ", "\[Sigma]"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"\[CapitalPi]", ",", " ", "\[CapitalPi]"}], "}"}], ",", 
         "\n", "        ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"quark", " ", "2"}], "-", "point"}], " ", "*)"}], "\n", 
         "        ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar"}], "}"}], ",", "\n", "        ", 
         RowBox[{"(*", " ", 
          RowBox[{"Yukawa", " ", 
           RowBox[{"vertices", ":", " ", 
            RowBox[{"{", 
             RowBox[{"Psi", ",", " ", "Psibar", ",", " ", "boson"}], 
             "}"}]}]}], " ", "*)"}], "\n", "        ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar", ",", " ", "\[Sigma]"}], "}"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar", ",", " ", "\[CapitalPi]"}], 
