Cell["\<\
Quark two-point flow equation. The derivative list uses the {Psi, Psibar} \
ordering of the truncation.\
\>", "Text",ExpressionUUID->"211a3659-e60f-470e-9781-f4a5a64e684a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"DSEQuark2P", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FTakeDerivatives", "[", 
        RowBox[{
         RowBox[{"FMakeDSE", "[", 
          RowBox[{"Psi", "[", "i2", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"Psibar", "[", "i1", "]"}], "}"}]}], "]"}], "//", 
       "FTruncate"}], "//", "FPlot"}], "//", "FRoute"}], "//", "FPrint"}]}], 
  ";"}]], "Input",
