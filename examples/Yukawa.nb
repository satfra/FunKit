Cell["\<\
In the DSE case, the symmetries can\[CloseCurlyQuote]t be built fully \
automatically. There are several ways to add the right symmetries to the terms:
First, just put them into the FEx directly:\
\>", "Text",
 CellChangeTimes->{{3.9870064288472*^9, 
  3.987006464824999*^9}},ExpressionUUID->"c1ae00be-b5c1-4af9-a16a-\
c2dbd2ca7473"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"symmetryP2", "=", 
   RowBox[{"FMakeSymmetryList", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[CapitalPi]", "[", "i1", "]"}], ",", 
      RowBox[{"\[CapitalPi]", "[", "i2", "]"}]}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DSE2P", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FEx", "[", 
        RowBox[{
         RowBox[{"FTakeDerivatives", "[", 
          RowBox[{
           RowBox[{"FMakeDSE", "[", 
            RowBox[{"\[CapitalPi]", "[", "i1", "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[CapitalPi]", "[", "i2", "]"}], "}"}]}], "]"}], ",", 
         RowBox[{"\"\<Symmetries\>\"", "->", "symmetryP2"}]}], "]"}], "//", 
       "FTruncate"}], "//", "FPlot"}], "//", "FRoute"}], "//", "FPrint"}]}], 
  ";"}]}], "Input",
