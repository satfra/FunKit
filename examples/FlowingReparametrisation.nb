Cell[BoxData[{
 RowBox[{
  RowBox[{"fRG\[CapitalPi]\[CapitalPi]", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"FTakeDerivatives", "[", 
        RowBox[{"GeneralizedFlowEquationRHS", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[CapitalPi]", "[", "i1", "]"}], ",", 
           RowBox[{"\[CapitalPi]", "[", "i2", "]"}]}], "}"}]}], "]"}], "//", 
       "FTruncate"}], "//", "FPlot"}], "//", "FRoute"}], "//", "FPrint"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"proj\[CapitalPi]\[CapitalPi]", "=", 
   RowBox[{"FTerm", "[", 
    RowBox[{"deltaAdjFlav", "[", 
     RowBox[{"f1", ",", "f2"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"flow\[CapitalPi]\[CapitalPi]RHS", "=", 
  RowBox[{"FormTrace", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"proj\[CapitalPi]\[CapitalPi]", "**", 
      RowBox[{
       RowBox[{"fRG\[CapitalPi]\[CapitalPi]", "[", "\"\<1-Loop\>\"", "]"}], 
       "[", "\"\<Expression\>\"", "]"}]}], "/.", 
     RowBox[{"FMakeDiagrammaticRules", "[", "]"}]}], "/.", "PhidotRules"}], 
   "]"}]}]}], "Input",
