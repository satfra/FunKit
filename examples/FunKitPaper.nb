Cell[BoxData["\<\"function DSE_kernel_AA_1Loop(l1, cos, p, Nc, gS, ZA, Zc, \
ZA3, ZAcbc, ZA4)\\n  cospl1 = cos\\n  _repl1 = ZA(sqrt(l1^2))\\n  _repl2 = \
l1^(-4)\\n  _repl3 = p^(-2)\\n  _repl4 = cospl1^2\\n  _repl5 = l1^2\\n  \
_repl6 = p^2\\n  _repl7 = l1^4\\n  _repl8 = p^4\\n  return \
(_repl2*_repl3*(-_repl4 + 7*_repl5*_repl6)*gS^2*Nc)/(3*_repl1) + \
(2*_repl2*_repl3*(_repl4*(7*_repl5*_repl6 + 3*_repl7 + 3*_repl8) - \
_repl5*_repl6*(8*_repl5*_repl6 + 3*_repl7 + 3*_repl8) - \
6*_repl5*_repl6*(_repl5 + _repl6)*cospl1 + 6*(_repl5 + _repl6)*cospl1^3 + \
cospl1^4)*gS*Nc*ZA3(sqrt(0.6666666666666666)*sqrt(_repl5 + _repl6 + \
cospl1)))/(3*_repl1*(_repl5 + _repl6 + 2*cospl1)^2*ZA(sqrt(_repl5 + _repl6 + \
2*cospl1))) + (_repl3*(_repl4 - \
_repl5*_repl6)*Nc*dressing(S,List(A,cb,c),1,List(p1,-l1 - \
p1,l1))*ZAcbc(sqrt(0.6666666666666666)*sqrt(_repl5 + _repl6 + \
cospl1)))/(3*(_repl5 + _repl6 + \
2*cospl1)*l1^2*Zc(sqrt(_repl5))*Zc(sqrt(_repl5 + _repl6 + 2*cospl1)))\\nend\"\
\>"], "Output",
 CellChangeTimes->{{3.978798497277256*^9, 3.978798516044026*^9}, 
   3.978798604049177*^9, {3.978798750203435*^9, 3.9787988090407267`*^9}, {
