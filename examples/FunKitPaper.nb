     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"InverseProp", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A"}], "}"}], ",", "2", ",", 
        RowBox[{"{", 
         RowBox[{"a_", ",", "b_"}], "}"}]}], "]"}], ":>", 
      RowBox[{"xi", "^", 
       RowBox[{"-", "1"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"InverseProp", ",", 
        RowBox[{"{", 
         RowBox[{"cb", ",", "c"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], ":>", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Zc", "[", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"sp", "[", 
           RowBox[{"p2", ",", "p2"}], "]"}], "]"}], "]"}]}], 
       RowBox[{"sp", "[", 
        RowBox[{"p2", ",", "p2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"S", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A", ",", "A"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
      "gS"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"S", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A", ",", "A", ",", "A"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_", ",", "p3_", ",", "p4_"}], "}"}]}], "]"}], 
      ":>", 
      RowBox[{"gS", "^", "2"}]}], ",", "\[IndentingNewLine]", 
