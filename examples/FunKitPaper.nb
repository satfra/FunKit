Cell[BoxData["\<\"FEx[term1, term2, ...]\\nRepresents a functional expression \
as a sum of FTerm objects.\\nThis is the main container for functional \
equations in FEDeriK.\\nFEx objects support non-commutative multiplication \
(**) and automatically handle simplification of zero terms.\"\>"], "Output",
 CellChangeTimes->{{3.978783550955501*^9, 3.9787835634875593`*^9}, 
