 RowBox[{"MakeCppFunction", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Total", "@", 
     RowBox[{"(", 
      RowBox[{"DSEAAResult1L", "//", "parametrize"}], ")"}]}], "/.", 
    RowBox[{"xi", "->", "0"}]}], ",", "\[IndentingNewLine]", 
   RowBox[{"\"\<Parameters\>\"", "->", 
