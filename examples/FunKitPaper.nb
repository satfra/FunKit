       "\"\<ExternalIndices\>\"", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"formRuleSP", "=", 
   RowBox[{"FMakeSPFormRule", "[", 
    RowBox[{
     RowBox[{"{", "l1", "}"}], ",", "p", ",", 
     RowBox[{"{", 
      RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"FormTrace", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FTerm", "[", "projAcbc", "]"}], "**", 
     RowBox[{
