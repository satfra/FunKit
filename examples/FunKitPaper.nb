        RowBox[{"-", "l1"}], ",", "l1"}], "}"}]}], "]"}], " ", 
    RowBox[{"dressing", "[", 
     RowBox[{"InverseProp", ",", 
      RowBox[{"{", 
       RowBox[{"cb", ",", "c"}], "}"}], ",", "1", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l1", "+", "p2"}], ",", 
        RowBox[{
         RowBox[{"-", "l1"}], "-", "p2"}]}], "}"}]}], "]"}], " ", 
    RowBox[{"dressing", "[", 
     RowBox[{"InverseProp", ",", 
      RowBox[{"{", 
       RowBox[{"cb", ",", "c"}], "}"}], ",", "1", ",", 
      RowBox[{"{", 
