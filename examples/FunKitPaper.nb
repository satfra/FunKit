          RowBox[{"l1", ",", "p2"}], "]"}], " ", 
         SqrtBox[
          RowBox[{"sp", "[", 
           RowBox[{"l1", ",", "l1"}], "]"}]]}], "+", 
        RowBox[{"3", " ", 
