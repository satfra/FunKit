Cell[BoxData[{
 RowBox[{
  RowBox[{"projAcbc", "=", 
   RowBox[{"TBGetProjector", "[", 
    RowBox[{"\"\<Acbc\>\"", ",", "1", ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i1", ",", "i2", ",", "i3"}], "}"}], "/.", 
      RowBox[{
       RowBox[{"DSEAcbc", "[", "\"\<1-Loop\>\"", "]"}], "[", 
       "\"\<ExternalIndices\>\"", "]"}]}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"formRuleSP", "=", 
   RowBox[{"FMakeSPFormRule", "[", 
    RowBox[{
     RowBox[{"{", "l1", "}"}], ",", "p", ",", 
     RowBox[{"{", 
      RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"FormTrace", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"FTerm", "[", "projAcbc", "]"}], "**", 
     RowBox[{
      RowBox[{
       RowBox[{"DSEAcbc", "[", "\"\<1-Loop\>\"", "]"}], "[", 
       "\"\<Expression\>\"", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}], "/.", "diagRules"}], ",", 
   RowBox[{"{", "}"}], ",", "formRuleSP"}], "]"}]}], "Input",
