Cell[BoxData[{
 RowBox[{
  RowBox[{"parameterizations", "=", 
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"InverseProp", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], ":>", 
      RowBox[{
       RowBox[{"ZA", "[", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"sp", "[", 
          RowBox[{"p2", ",", "p2"}], "]"}], "]"}], "]"}], 
       RowBox[{"sp", "[", 
        RowBox[{"p2", ",", "p2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"InverseProp", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A"}], "}"}], ",", "2", ",", 
        RowBox[{"{", 
         RowBox[{"a_", ",", "b_"}], "}"}]}], "]"}], ":>", 
      RowBox[{"xi", "^", 
       RowBox[{"-", "1"}]}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"InverseProp", ",", 
        RowBox[{"{", 
         RowBox[{"cb", ",", "c"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_"}], "}"}]}], "]"}], ":>", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Zc", "[", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"sp", "[", 
           RowBox[{"p2", ",", "p2"}], "]"}], "]"}], "]"}]}], 
       RowBox[{"sp", "[", 
        RowBox[{"p2", ",", "p2"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"S", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A", ",", "A"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
      "gS"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"S", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A", ",", "A", ",", "A"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_", ",", "p3_", ",", "p4_"}], "}"}]}], "]"}], 
      ":>", 
      RowBox[{"gS", "^", "2"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"S", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
      "gS"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"GammaN", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "A", ",", "A"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
      RowBox[{"ZA3", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sp", "[", 
            RowBox[{"p1", ",", "p1"}], "]"}], "+", 
           RowBox[{"sp", "[", 
            RowBox[{"p2", ",", "p2"}], "]"}], "+", 
           RowBox[{"sp", "[", 
            RowBox[{"p3", ",", "p3"}], "]"}]}], ")"}], "/", "3"}], "]"}], 
       "]"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"GammaN", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
      RowBox[{"ZAcbc", "[", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"sp", "[", 
            RowBox[{"p1", ",", "p1"}], "]"}], "+", 
           RowBox[{"sp", "[", 
            RowBox[{"p2", ",", "p2"}], "]"}], "+", 
           RowBox[{"sp", "[", 
            RowBox[{"p3", ",", "p3"}], "]"}]}], ")"}], "/", "3"}], "]"}], 
       "]"}]}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"lf1", "->", "l1"}], ",", 
     RowBox[{"p1", "->", "p"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"cos", "[", 
       RowBox[{"p", ",", "l1"}], "]"}], "->", "cospl1"}], ",", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"l1", ",", "l1"}], "]"}], ":>", 
      RowBox[{"l1", "^", "2"}]}], ",", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"p", ",", "p"}], "]"}], ":>", 
      RowBox[{"p", "^", "2"}]}], ",", 
     RowBox[{
      RowBox[{"sp", "[", 
       RowBox[{"l1", ",", "p"}], "]"}], ":>", 
      RowBox[{
       RowBox[{"cos", "[", 
        RowBox[{"p", ",", "l1"}], "]"}], " ", "l1", " ", "p"}]}], ",", " ", 
     RowBox[{
      RowBox[{"cos", "[", 
       RowBox[{"p", ",", "l1"}], "]"}], ":>", "cospl1"}]}], 
    "\[IndentingNewLine]", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"parametrize", "[", "expr_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"UseLorentzLinearity", "[", 
      RowBox[{"expr", "//.", "parameterizations"}], "]"}], "//.", 
