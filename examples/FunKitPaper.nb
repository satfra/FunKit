Cell[BoxData["\<\"auto DSE_kernel_AA_1Loop(const auto &l1, const auto &cos, \
const auto &p, const auto &Nc, const auto &gS, const auto &ZA, const auto \
&Zc,\\n                         const auto &ZA3, const auto &ZAcbc, const \
auto &ZA4)\\n{\\n  using namespace std;\\n  const auto &cospl1 = cos;\\n  \
const auto _interp1 = ZA(sqrt(powr<2>(l1)));\\n  const auto _interp2 = \
ZA(sqrt(powr<2>(l1) + powr<2>(p) + 2. * cospl1 * l1 * p1));\\n  const auto \
_interp3 = ZA3(0.816496580927726 * sqrt(powr<2>(l1) + powr<2>(p) + cospl1 * \
l1 * p1));\\n  const auto _interp4 = ZAcbc(0.816496580927726 * \
sqrt(powr<2>(l1) + powr<2>(p) + cospl1 * l1 * p1));\\n  const auto _interp5 = \
Zc(sqrt(powr<2>(l1)));\\n  const auto _interp6 = Zc(sqrt(powr<2>(l1) + \
powr<2>(p) + 2. * cospl1 * l1 * p1));\\n  const auto _cse1 = powr<2>(p);\\n  \
const auto _cse2 = powr<-1>(_cse1);\\n  const auto _cse3 = \
powr<2>(cospl1);\\n  const auto _cse4 = powr<2>(p1);\\n  const auto _cse5 = \
-_cse3 * _cse4;\\n  const auto _cse6 = powr<-1>(_cse7);\\n  const auto _cse7 \
= powr<2>(l1);\\n  const auto _cse8 = 2. * cospl1 * l1 * p1;\\n  const auto \
_cse9 = _cse1 + _cse7 + _cse8;\\n  const auto _cse10 = _cse1 + _cse5;\\n  \
const auto _cse11 = powr<-1>(_interp1); // clang-format off\\n\\n  return \
0.3333333333333333 *\\n    fma(-6.,\\n        powr<2>(_cse1) * _cse10 * \
_cse11 * _cse2 * _cse6 * powr<-2>(_cse9) * powr<-1>(_interp2) *\\n            \
_interp3 * gS * Nc,\\n        fma(-16.,\\n            _cse1 * _cse10 * _cse11 \
* _cse2 * _cse6 * _cse7 * powr<-2>(_cse9) * powr<-1>(_interp2) *\\n           \
     _interp3 * gS * Nc,\\n            fma(-2.,\\n                _cse10 * \
_cse11 * _cse2 * _cse3 * _cse4 * _cse6 * _cse7 * powr<-2>(_cse9) *\\n         \
           powr<-1>(_interp2) * _interp3 * gS * Nc,\\n                \
fma(-6.,\\n                    _cse10 * _cse11 * _cse2 * _cse6 * \
powr<2>(_cse7) * powr<-2>(_cse9) *\\n                        \
powr<-1>(_interp2) * _interp3 * gS * Nc,\\n                    fma(-1.,\\n    \
                    _cse10 * _cse2 * powr<-1>(_cse9) * _interp4 * \
powr<-1>(_interp5) *\\n                            powr<-1>(_interp6) * gS * \
Nc,\\n                        fma(7., _cse1 * _cse11 * _cse2 * _cse6 * \
powr<2>(gS) * Nc,\\n                            fma(_cse11, _cse2 * _cse5 * \
_cse6 * powr<2>(gS) * Nc,\\n                                fma(-12.,\\n      \
                              _cse1 * _cse10 * _cse11 * _cse2 * _cse6 * \
powr<-2>(_cse9) *\\n                                        \
powr<-1>(_interp2) * _interp3 * cospl1 * gS * l1 * Nc * p1,\\n                \
                    fma(-12.,\\n                                        \
_cse10 * _cse11 * _cse2 * _cse6 * powr<-2>(_cse9) *\\n                        \
                    powr<-1>(_interp2) * _interp3 * cospl1 * gS *\\n          \
                                  powr<3>(l1) * Nc * p1,\\n                   \
                     0.)))))))));\\n  // clang-format on\\n}\"\>"], "Output",
 CellChangeTimes->{
