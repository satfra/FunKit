     "\"\<l1\>\"", ",", "\"\<cos\>\"", ",", "\"\<p\>\"", ",", "\"\<Nc\>\"", 
      ",", "\"\<gS\>\"", ",", "\"\<ZA\>\"", ",", "\"\<Zc\>\"", ",", 
