     RowBox[{
     "\"\<l1\>\"", ",", "\"\<cos\>\"", ",", "\"\<p\>\"", ",", "\"\<Nc\>\"", 
      ",", "\"\<gS\>\"", ",", "\"\<ZA\>\"", ",", "\"\<Zc\>\"", ",", 
      "\"\<ZA3\>\"", ",", "\"\<ZAcbc\>\"", ",", "\"\<ZA4\>\""}], "}"}]}], ",",
    "\[IndentingNewLine]", 
