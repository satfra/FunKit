Cell[BoxData["\<\"function DSE_kernel_AA_1Loop(l1, cospl1, p, Nc, gS, ZA, Zc, \
ZA3, ZAcbc, ZA4)\\n  _interp1 = ZA(sqrt(l1^2))\\n  _interp2 = ZA(sqrt(l1^2 + \
2*cospl1*l1*p + p^2))\\n  _interp3 = ZA3(sqrt(0.6666666666666666)*sqrt(l1^2 + \
cospl1*l1*p + p^2))\\n  _interp4 = ZAcbc(sqrt(0.6666666666666666)*sqrt(l1^2 + \
cospl1*l1*p + p^2))\\n  _interp5 = Zc(sqrt(l1^2))\\n  _interp6 = Zc(sqrt(l1^2 \
+ 2*cospl1*l1*p + p^2))\\n  _cse1 = cospl1^2\\n  _cse2 = -1 + _cse1\\n  _cse4 \
= l1^2\\n  _cse3 = 1/_cse4\\n  _cse5 = 2*cospl1*l1*p\\n  _cse6 = p^2\\n  \
_cse7 = _cse4 + _cse5 + _cse6\\n  _cse8 = 1/_interp1\\n  return \
fma(6,(_cse2*_cse3*_cse4^2*_cse8*_interp3*gS*Nc)/(_cse7^2*_interp2),fma(16,(_\
cse2*_cse3*_cse4*_cse6*_cse8*_interp3*gS*Nc)/(_cse7^2*_interp2),fma(2,(_cse1*_\
cse2*_cse3*_cse4*_cse6*_cse8*_interp3*gS*Nc)/(_cse7^2*_interp2),fma(6,(_cse2*_\
cse3*_cse6^2*_cse8*_interp3*gS*Nc)/(_cse7^2*_interp2),fma(-1,(_cse2*_interp4*\
gS*Nc)/(_cse7*_interp5*_interp6),fma(7,_cse3*_cse8*gS^2*Nc,fma(-1,_cse1*_cse3*\
_cse8*gS^2*Nc,fma(12,(_cse2*_cse3*_cse8*_interp3*cospl1*gS*l1^3*Nc*p)/(_cse7^\
2*_interp2),fma(12,(_cse2*_cse3*_cse8*_interp3*cospl1*gS*l1*Nc*p^3)/(_cse7^2*_\
interp2),0)))))))))/3.\\nend\"\>"], "Output",
 CellChangeTimes->{{3.978798497277256*^9, 3.978798516044026*^9}, 
