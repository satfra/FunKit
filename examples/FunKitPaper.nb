      ":>", 
      RowBox[{"gS", "^", "2"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"dressing", "[", 
       RowBox[{"S", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1_", ",", "p2_", ",", "p3_"}], "}"}]}], "]"}], ":>", 
