      RowBox[{"dressing", "[", 
       RowBox[{"GammaN", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"l1", ",", "p2", ",", 
          RowBox[{
           RowBox[{"-", "l1"}], "-", "p2"}]}], "}"}]}], "]"}], " ", 
      RowBox[{"dressing", "[", 
       RowBox[{"S", ",", 
        RowBox[{"{", 
         RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"p1", ",", 
          RowBox[{"l1", "+", "p2"}], ",", 
          RowBox[{
           RowBox[{"-", "l1"}], "-", "p1", "-", "p2"}]}], "}"}]}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"cos", "[", 
          RowBox[{"l1", ",", "p1"}], "]"}], " ", 
         SqrtBox[
          RowBox[{"sp", "[", 
           RowBox[{"l1", ",", "l1"}], "]"}]]}], "+", 
        RowBox[{"4", " ", 
