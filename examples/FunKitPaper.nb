Cell[BoxData["\<\"function DSE_kernel_AA_1Loop(l1, cos, p, Nc, gS, ZA, Zc, \
ZA3, ZAcbc, ZA4)\\n  cospl1 = cos\\n  _interp1 = ZA(sqrt(l1^2))\\n  _interp2 \
= ZA(sqrt(l1^2 + p^2 + 2*cospl1*l1*p1))\\n  _interp3 = \
ZA3(sqrt(0.6666666666666666)*sqrt(l1^2 + p^2 + cospl1*l1*p1))\\n  _interp4 = \
ZAcbc(sqrt(0.6666666666666666)*sqrt(l1^2 + p^2 + cospl1*l1*p1))\\n  _interp5 \
= Zc(sqrt(l1^2))\\n  _interp6 = Zc(sqrt(l1^2 + p^2 + 2*cospl1*l1*p1))\\n  \
_cse1 = p^2\\n  _cse2 = 1/_cse1\\n  _cse3 = cospl1^2\\n  _cse4 = p1^2\\n  \
_cse5 = -(_cse3*_cse4)\\n  _cse6 = 1/_cse7\\n  _cse7 = l1^2\\n  _cse8 = \
2*cospl1*l1*p1\\n  _cse9 = _cse1 + _cse7 + _cse8\\n  _cse10 = _cse1 + \
_cse5\\n  _cse11 = 1/_interp1\\n  return \
fma(-6,(_cse1^2*_cse10*_cse11*_cse2*_cse6*_interp3*gS*Nc)/(_cse9^2*_interp2),\
fma(-16,(_cse1*_cse10*_cse11*_cse2*_cse6*_cse7*_interp3*gS*Nc)/(_cse9^2*_\
interp2),fma(-2,(_cse10*_cse11*_cse2*_cse3*_cse4*_cse6*_cse7*_interp3*gS*Nc)/(\
_cse9^2*_interp2),fma(-6,(_cse10*_cse11*_cse2*_cse6*_cse7^2*_interp3*gS*Nc)/(_\
cse9^2*_interp2),fma(-1,(_cse10*_cse2*_interp4*gS*Nc)/(_cse9*_interp5*_\
interp6),fma(7,_cse1*_cse11*_cse2*_cse6*gS^2*Nc,fma(_cse11,_cse2*_cse5*_cse6*\
gS^2*Nc,fma(-12,(_cse1*_cse10*_cse11*_cse2*_cse6*_interp3*cospl1*gS*l1*Nc*p1)/\
(_cse9^2*_interp2),fma(-12,(_cse10*_cse11*_cse2*_cse6*_interp3*cospl1*gS*l1^3*\
Nc*p1)/(_cse9^2*_interp2),0)))))))))/3.\\nend\"\>"], "Output",
 CellChangeTimes->{{3.978798497277256*^9, 3.978798516044026*^9}, 
   3.978798604049177*^9, {3.978798750203435*^9, 3.9787988090407267`*^9}, {
