Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{"Nc", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", 
      RowBox[{"2", " ", 
       RowBox[{"cos", "[", 
        RowBox[{"l1", ",", "p1"}], "]"}], " ", 
       RowBox[{"cos", "[", 
        RowBox[{"l1", ",", "p2"}], "]"}]}], "+", 
      RowBox[{"2", " ", 
       SuperscriptBox[
        RowBox[{"cos", "[", 
         RowBox[{"l1", ",", "p2"}], "]"}], "2"]}]}], ")"}], " ", 
    RowBox[{"dressing", "[", 
     RowBox[{"GammaN", ",", 
      RowBox[{"{", 
       RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", "1", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "l1"}], ",", 
        RowBox[{"l1", "+", "p1", "+", "p2"}], ",", 
        RowBox[{
         RowBox[{"-", "p1"}], "-", "p2"}]}], "}"}]}], "]"}], " ", 
    RowBox[{"dressing", "[", 
     RowBox[{"GammaN", ",", 
      RowBox[{"{", 
       RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", "1", ",", 
      RowBox[{"{", 
       RowBox[{"l1", ",", "p2", ",", 
        RowBox[{
         RowBox[{"-", "l1"}], "-", "p2"}]}], "}"}]}], "]"}], " ", 
    RowBox[{"dressing", "[", 
     RowBox[{"S", ",", 
      RowBox[{"{", 
       RowBox[{"A", ",", "cb", ",", "c"}], "}"}], ",", "1", ",", 
      RowBox[{"{", 
       RowBox[{"p1", ",", 
        RowBox[{"l1", "+", "p2"}], ",", 
        RowBox[{
         RowBox[{"-", "l1"}], "-", "p1", "-", "p2"}]}], "}"}]}], "]"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"cos", "[", 
        RowBox[{"l1", ",", "p1"}], "]"}], " ", 
       SqrtBox[
        RowBox[{"sp", "[", 
         RowBox[{"l1", ",", "l1"}], "]"}]]}], "+", 
      RowBox[{"4", " ", 
       RowBox[{"cos", "[", 
        RowBox[{"l1", ",", "p2"}], "]"}], " ", 
       SqrtBox[
        RowBox[{"sp", "[", 
         RowBox[{"l1", ",", "l1"}], "]"}]]}], "+", 
      RowBox[{"3", " ", 
       SqrtBox[
        RowBox[{"sp", "[", 
         RowBox[{"p", ",", "p"}], "]"}]]}]}], ")"}], " ", 
    SqrtBox[
     RowBox[{"sp", "[", 
      RowBox[{"p", ",", "p"}], "]"}]]}], ")"}], "/", 
  RowBox[{"(", 
   RowBox[{"12", " ", 
    RowBox[{"dressing", "[", 
