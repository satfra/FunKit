Cell[CellGroupData[{

Cell["Two-point <O(p) O(q)>", "Section",ExpressionUUID->"e08db297-d26c-4d7b-8d68-35de141907b2"],

Cell["\<\
Build the operator product, apply the rule to all four fields (giving 2^4 = \
16 terms), resolve, set sources to zero, truncate.\
\>", "Text",ExpressionUUID->"9520753f-1572-47db-a6d2-8165d4f07650"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"twoOpRaw", "=", 
   RowBox[{
    RowBox[{"COp", "[", "i1", "]"}], "**", 
    RowBox[{"COp", "[", "i2", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"twoOpExpanded", "=", 
   RowBox[{"twoOpRaw", "//", "phiToPhiPlusGD"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gop2Pt", "=", 
   RowBox[{
    RowBox[{"twoOpExpanded", "//", "FResolveDerivatives"}], "//", 
    "FTruncate"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.986441244661323*^9, 3.9864412950768623`*^9}, {
  3.9864414357642593`*^9, 3.986441465201188*^9}, {3.986441820284734*^9, 
  3.986441824456373*^9}},
 CellLabel->
  "In[193]:=",ExpressionUUID->"dae4b7db-01e5-447d-8725-6558a251f00a"],

