Cell[CellGroupData[{

Cell["Field space and truncation", "Subsection",ExpressionUUID->"6963b498-f933-494a-8c53-db14ffcf63f3"],

Cell["\<\
Yukawa fields: real scalar Phi, Dirac fermion (Psibar, Psi). Truncation \
includes the cubic Yukawa vertex and the four-fermion vertex.\
\>", "Text",ExpressionUUID->"68c8f17c-220f-4926-9ab5-26c5d585f2b1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fields", " ", "=", " ", 
    RowBox[{"<|", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\"\<Commuting\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"Phi", "[", "p", "]"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<Grassmann\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Psibar", "[", 
           RowBox[{"p", ",", 
            RowBox[{"{", "a", "}"}]}], "]"}], ",", 
          RowBox[{"Psi", "[", 
           RowBox[{"p", ",", 
            RowBox[{"{", "a", "}"}]}], "]"}]}], "}"}], "}"}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"truncation", " ", "=", " ", 
    RowBox[{"<|", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Rdot", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Phi", ",", "Phi"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", "Psibar"}], "}"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Propagator", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Phi", ",", " ", "Phi"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar"}], "}"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"GammaN", "     ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "Phi", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Phi", ",", " ", "Phi"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar", ",", " ", "Phi"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "Psibar", ",", " ", "Psibar", ",", " ", "Psi", ",", " ", "Psi"}], 
          "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"Field", "->", 
       RowBox[{"{", 
        RowBox[{"{", "}"}], "}"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}],
   "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Setup", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<FieldSpace\>\"", "->", "fields"}], ",", 
     RowBox[{"\"\<Truncation\>\"", "->", "truncation"}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"FSetGlobalSetup", "[", "Setup", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FSetTexStyles", "[", 
   RowBox[{
    RowBox[{"Psi", "->", "\"\<\\\\psi\>\""}], ",", 
    RowBox[{"Psibar", "->", "\"\<\\\\bar{\\\\psi}\>\""}], ",", 
    RowBox[{"Phi", "->", "\"\<\\\\phi\>\""}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{
  3.986441058328253*^9, {3.98644140694407*^9, 3.986441410440246*^9}, {
   3.986441617449193*^9, 3.9864417090764008`*^9}},
 CellLabel->
  "In[181]:=",ExpressionUUID->"774754f5-a471-41fa-b5a7-9b30a9ffb370"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Composite operator and replacement rule", "Section",ExpressionUUID->"518220b8-a4aa-484b-a10f-d03ecfb85228"],

Cell["\<\
The composite operator O(idx) = Psibar(idx) Psi(idx). Both fermions share one \
super-index, which contracts their internal indices.

phiToPhiPlusGD substitutes phi -> Phi + G . d/dPhi for every elementary field.\
\>", "Text",
 CellChangeTimes->{{3.986441441203418*^9, 
  3.98644144140335*^9}},ExpressionUUID->"f23eaae2-0f8b-4b7c-8c69-\
2cd444915f7c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"allFields", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"Phi", ",", " ", "Psibar", ",", " ", "Psi"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"COp", "[", "idx_", "]"}], " ", ":=", " ", 
    RowBox[{"FEx", "[", 
     RowBox[{"FTerm", "[", 
      RowBox[{
       RowBox[{"Psibar", "[", 
        RowBox[{"Symbol", "[", 
         RowBox[{
          RowBox[{"SymbolName", "[", "idx", "]"}], "<>", "\"\<1\>\""}], "]"}],
         "]"}], ",", " ", 
       RowBox[{"Psi", "[", 
        RowBox[{"Symbol", "[", 
         RowBox[{
          RowBox[{"SymbolName", "[", "idx", "]"}], "<>", "\"\<2\>\""}], "]"}],
         "]"}]}], "]"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phiToPhiPlusGD", "[", "expr_", "]"}], ":=", 
   RowBox[{"Replace", "[", 
    RowBox[{"expr", ",", "\[IndentingNewLine]", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"#", "[", "id_", "]"}], " ", ":>", " ", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", "i", "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"FEx", "[", 
             RowBox[{
              RowBox[{"FTerm", "[", 
               RowBox[{"#", "[", "id", "]"}], "]"}], ",", 
              RowBox[{"FTerm", "[", 
               RowBox[{
                RowBox[{"Propagator", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"#", ",", "AnyField"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"id", ",", "i"}], "}"}]}], "]"}], ",", 
                RowBox[{"FDOp", "[", 
                 RowBox[{"AnyField", "[", "i", "]"}], "]"}]}], "]"}]}], 
             "]"}]}], "\[IndentingNewLine]", "]"}]}], ")"}], "&"}], ",", 
       "\[IndentingNewLine]", "allFields"}], "\[IndentingNewLine]", "]"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9864413584531097`*^9, 3.98644137494808*^9}, 
   3.9864414302685833`*^9, {3.986441465927243*^9, 3.9864415187239847`*^9}, {
   3.9864417321764107`*^9, 3.986441782752142*^9}, {3.9864420208124866`*^9, 
   3.986442039560158*^9}},
 CellLabel->
