Cell["Split into disconnected and connected pieces.", "Text",
 CellChangeTimes->{
  3.986441240991888*^9},ExpressionUUID->"e28ba011-c612-49da-88f9-\
7b1aef5b77ad"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"disconnectedPart", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"Gop2Pt", ",", 
     RowBox[{
      RowBox[{"FDisconnectedQ", "[", 
       RowBox[{"Setup", ",", " ", "#"}], "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"connectedPart", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"Gop2Pt", ",", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"FDisconnectedQ", "[", 
        RowBox[{"Setup", ",", " ", "#"}], "]"}]}], "&"}]}], "]"}]}], 
  ";"}]}], "Input",
