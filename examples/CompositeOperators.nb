Cell["\<\
Yukawa fields: real scalar Phi, Dirac fermion (Psibar, Psi). Truncation \
includes the Yukawa vertex and the four-fermion vertex.\
\>", "Text",
 CellChangeTimes->{{3.987089455182701*^9, 
  3.987089456382333*^9}},ExpressionUUID->"68c8f17c-220f-4926-9ab5-\
26c5d585f2b1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fields", " ", "=", " ", 
    RowBox[{"<|", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"\"\<Commuting\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"Phi", "[", "p", "]"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"\"\<Grassmann\>\"", "->", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Psibar", "[", 
           RowBox[{"p", ",", 
            RowBox[{"{", "a", "}"}]}], "]"}], ",", 
          RowBox[{"Psi", "[", 
           RowBox[{"p", ",", 
            RowBox[{"{", "a", "}"}]}], "]"}]}], "}"}], "}"}]}]}], 
     "\[IndentingNewLine]", "|>"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"truncation", " ", "=", " ", 
    RowBox[{"<|", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Rdot", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Phi", ",", "Phi"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", "Psibar"}], "}"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Propagator", " ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Phi", ",", " ", "Phi"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar"}], "}"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"GammaN", "     ", "->", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", "Phi", "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar"}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"Phi", ",", " ", "Phi"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"Psi", ",", " ", "Psibar", ",", " ", "Phi"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
          "Psibar", ",", " ", "Psibar", ",", " ", "Psi", ",", " ", "Psi"}], 
          "}"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"Field", "->", 
       RowBox[{"{", 
        RowBox[{"{", "}"}], "}"}]}]}], "\[IndentingNewLine]", "|>"}]}], ";"}],
   "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"setup", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<FieldSpace\>\"", "->", "fields"}], ",", 
     RowBox[{"\"\<Truncation\>\"", "->", "truncation"}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"FSetGlobalSetup", "[", "setup", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FSetTexStyles", "[", 
   RowBox[{
    RowBox[{"Psi", "->", "\"\<\\\\psi\>\""}], ",", 
    RowBox[{"Psibar", "->", "\"\<\\\\bar{\\\\psi}\>\""}], ",", 
    RowBox[{"Phi", "->", "\"\<\\\\phi\>\""}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{
  3.986441058328253*^9, {3.98644140694407*^9, 3.986441410440246*^9}, {
   3.986441617449193*^9, 3.9864417090764008`*^9}, {3.9870894650797777`*^9, 
   3.987089467114029*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"774754f5-a471-41fa-b5a7-9b30a9ffb370"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Composite operator and replacement rule", "Section",ExpressionUUID->"518220b8-a4aa-484b-a10f-d03ecfb85228"],

Cell["\<\
The composite operator O(idx) = Psibar(idx) Psi(idx). Both fermions share one \
super-index, which contracts their internal indices.\
\>", "Text",
 CellChangeTimes->{{3.986441441203418*^9, 3.98644144140335*^9}, 
   3.987089546178729*^9},ExpressionUUID->"51bf91a5-125e-4cb8-92c5-\
4c2a98a5e6c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"COp", "[", "idx_", "]"}], " ", ":=", " ", 
   RowBox[{"FEx", "[", 
    RowBox[{"FTerm", "[", 
     RowBox[{
      RowBox[{"Psibar", "[", 
       RowBox[{"Symbol", "[", 
        RowBox[{
         RowBox[{"SymbolName", "[", "idx", "]"}], "<>", "\"\<1\>\""}], "]"}], 
       "]"}], ",", " ", 
      RowBox[{"Psi", "[", 
       RowBox[{"Symbol", "[", 
        RowBox[{
         RowBox[{"SymbolName", "[", "idx", "]"}], "<>", "\"\<2\>\""}], "]"}], 
       "]"}]}], "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.987089548927267*^9},ExpressionUUID->"f7a28627-f633-4b69-86fb-\
c5c599a25f44"],

Cell["\<\
phiToPhiPlusGD substitutes phi -> Phi + G*\[Delta]/\[Delta]Phi for every \
elementary field. For that we first create the corresponding replacements \
list:\
\>", "Text",
 CellChangeTimes->{{3.986441441203418*^9, 3.98644144140335*^9}, {
  3.987089555014264*^9, 3.987089580734433*^9}, {3.987089643065942*^9, 
  3.98708968591844*^9}},ExpressionUUID->"f23eaae2-0f8b-4b7c-8c69-\
2cd444915f7c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"allFields", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"Phi", ",", " ", "Psibar", ",", " ", "Psi"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"insertDerivatives", "=", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"#", "[", "id_", "]"}], " ", ":>", " ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", "i", "}"}], ",", "\[IndentingNewLine]", 
         RowBox[{"FEx", "[", 
          RowBox[{
           RowBox[{"FTerm", "[", 
            RowBox[{"#", "[", "id", "]"}], "]"}], ",", 
           RowBox[{"FTerm", "[", 
            RowBox[{
             RowBox[{"Propagator", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#", ",", "AnyField"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"id", ",", "i"}], "}"}]}], "]"}], ",", 
             RowBox[{"FDOp", "[", 
              RowBox[{"AnyField", "[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", "]"}]}], ")"}], "&"}], ",", 
    "\[IndentingNewLine]", "allFields"}], "\[IndentingNewLine]", 
   "]"}]}]}], "Input",
 CellChangeTimes->{3.987089701590559*^9},
 CellLabel->"In[42]:=",ExpressionUUID->"5de367df-b0ac-48de-95c8-79d7d1266674"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{"Phi", "[", "id_", "]"}], "\[RuleDelayed]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "i", "}"}], ",", 
      RowBox[{"FEx", "[", 
       RowBox[{
        RowBox[{"FTerm", "[", 
         RowBox[{"Phi", "[", "id", "]"}], "]"}], ",", 
        RowBox[{"FTerm", "[", 
         RowBox[{
          RowBox[{"Propagator", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Phi", ",", "AnyField"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"id", ",", "i"}], "}"}]}], "]"}], ",", 
          RowBox[{"FDOp", "[", 
           RowBox[{"AnyField", "[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], 
     "]"}]}], ",", 
   RowBox[{
    RowBox[{"Psibar", "[", "id_", "]"}], "\[RuleDelayed]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "i", "}"}], ",", 
      RowBox[{"FEx", "[", 
       RowBox[{
        RowBox[{"FTerm", "[", 
         RowBox[{"Psibar", "[", "id", "]"}], "]"}], ",", 
        RowBox[{"FTerm", "[", 
         RowBox[{
          RowBox[{"Propagator", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Psibar", ",", "AnyField"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"id", ",", "i"}], "}"}]}], "]"}], ",", 
          RowBox[{"FDOp", "[", 
           RowBox[{"AnyField", "[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], 
     "]"}]}], ",", 
   RowBox[{
    RowBox[{"Psi", "[", "id_", "]"}], "\[RuleDelayed]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "i", "}"}], ",", 
      RowBox[{"FEx", "[", 
       RowBox[{
        RowBox[{"FTerm", "[", 
         RowBox[{"Psi", "[", "id", "]"}], "]"}], ",", 
        RowBox[{"FTerm", "[", 
         RowBox[{
          RowBox[{"Propagator", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Psi", ",", "AnyField"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"id", ",", "i"}], "}"}]}], "]"}], ",", 
          RowBox[{"FDOp", "[", 
           RowBox[{"AnyField", "[", "i", "]"}], "]"}]}], "]"}]}], "]"}]}], 
     "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.987089637786297*^9, 3.9870897383190193`*^9},
 CellLabel->"Out[43]=",ExpressionUUID->"037e5cc3-ca03-4e49-8b54-8ceb1c62c352"]
}, Open  ]],

Cell["\<\
And then, for convenience, the actual function to insert the substitutions:\
\>", "Text",
 CellChangeTimes->{{3.987089707768277*^9, 
  3.987089726094388*^9}},ExpressionUUID->"ab19b81d-5cbc-4140-8cda-\
d083b5316c7e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"phiToPhiPlusGD", "[", "expr_", "]"}], ":=", 
   RowBox[{"Replace", "[", 
    RowBox[{"expr", ",", "insertDerivatives", ",", 
     RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9864413584531097`*^9, 3.98644137494808*^9}, 
   3.9864414302685833`*^9, {3.986441465927243*^9, 3.9864415187239847`*^9}, {
   3.9864417321764107`*^9, 3.986441782752142*^9}, {3.9864420208124866`*^9, 
   3.986442039560158*^9}, {3.987089533271537*^9, 3.987089538404747*^9}, {
   3.987089604562357*^9, 3.987089634996359*^9}, {3.9870896885028687`*^9, 
   3.98708970479109*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"7fdf84a6-cdae-4acb-bd4a-1e3009169f4d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["One-point <O>", "Section",ExpressionUUID->"1c1810ec-6b9b-4b8d-83ea-ff864217cc69"],

Cell["\<\
Apply the rule to the single FTerm of O(i1), resolve, truncate. The surviving \
diagram is the chiral condensate.\
\>", "Text",
 CellChangeTimes->{
  3.9864452347041607`*^9},ExpressionUUID->"03a32562-22d6-4ebc-b82e-\
a65417094dae"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"oneOpRaw", "=", 
   RowBox[{"COp", "[", "i", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oneOpExpanded", "=", 
   RowBox[{"oneOpRaw", "//", "phiToPhiPlusGD"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Gop1Pt", "=", 
   RowBox[{
    RowBox[{"oneOpExpanded", "//", "FResolveDerivatives"}], "//", 
    "FTruncate"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Gop1Pt", "//", "FPrint"}], "//", "FPlot"}], ";"}]}], "Input",
 CellChangeTimes->{{3.9864413009561872`*^9, 3.986441348779936*^9}, {
   3.9864413955563173`*^9, 3.986441396187971*^9}, 3.986441465200121*^9, {
   3.986441802351708*^9, 3.986441811120088*^9}, {3.987089430059375*^9, 
   3.987089430224365*^9}, {3.987089789755686*^9, 3.9870897923312683`*^9}},
 CellLabel->"In[57]:=",ExpressionUUID->"2a9fec5b-0ca2-43fa-b301-26922b0b4d96"],

