Cell[CellGroupData[{
Cell["Composite Operators in Yukawa Theory", "Title",ExpressionUUID->"2654cbe6-836a-4cb8-a6e2-6d12b803d025"],

Cell["\<\
Derive correlation functions of the fermion bilinear O = Psibar Psi in Yukawa \
theory using that  <F(phi)> = F[Phi + Propagator . d/dPhi].
We compute here <O> and <O(p) O(q)>.\
\>", "Text",
 CellChangeTimes->{{3.986441872955776*^9, 
  3.986441904368053*^9}},ExpressionUUID->"c6c5367b-65e7-413e-86bc-\
986700041b7c"],

